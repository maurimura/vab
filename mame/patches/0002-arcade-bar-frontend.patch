+   std::stable_sort(entries.begin(), entries.end(), [] (const entry &a, const entry &b)
+         { return a.port != b.port ? a.port < b.port : a.order < b.order; });
+   labels.clear();
+   labels.reserve(entries.size()); /* descriptors point into it */
+   for (const auto &e : entries)
+   {
+      labels.push_back(e.label);
+      descriptors.push_back({ e.port, e.device, 0, e.id, labels.back().c_str() });
+   }
+   descriptors.push_back({ 0, 0, 0, 0, NULL });
+   environ_cb(RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS, descriptors.data());
+}
