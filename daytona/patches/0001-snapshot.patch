+namespace rt::tgpgen {
+const uint32_t program_crc32 = crc32_words(kTgpProgram, 4);
+const uint32_t program_words = 4;
+// Each input word: a result out, a word into data RAM and one into buffer RAM.
+void run(Tgp &t, uint64_t budget) {
+    for (;;) {
+        if (t.count >= budget) return;
+        switch (t.pc) {
+        case 0: {
+            const uint32_t v = t.read_reg<0x21>();
+            if (t.stall) {
+                t.stall = false;
+                return;
+            }
+            t.d = v;
+            ++t.count, t.pc = 1;
+            break;
+        }
+        case 1:
+            t.a = t.d * 3 + t.data_r(5) + uint32_t(t.count);
+            t.data_w(uint16_t(t.d & 0xff), t.a);
+            t.write_reg<0x23>(0x00400000); // the bank: buffer RAM
+            t.io_w(uint16_t(0x40 + (t.d & 0x3f)), t.a ^ 0xffff);
+            t.write_reg<0x23>(0);
+            ++t.count, t.pc = 2;
+            break;
+        default:
+            t.write_reg<0x22>(t.a);
+            ++t.count, t.pc = 0;
+            break;
+        }
+    }
+}
