+#if defined(__EMSCRIPTEN__) && HOST_CPU == CPU_GENERIC
+// Whether a memory region is somewhere else than when this was last asked: the WASM backend's
+// compiled modules bake the regions' addresses in, so modules made before a move are stale.
+// Records the addresses for the next time.
+static bool memoryRegionsMoved()
+{
+	static u8 *ramAt, *vramAt, *aramAt, *ctxAt;
+	u8 *ram = &mem_b[0], *vr = &vram[0], *ar = &aica::aica_ram[0], *cx = (u8 *)p_sh4rcb;
+	bool moved = ramAt != nullptr && (ram != ramAt || vr != vramAt || ar != aramAt || cx != ctxAt);
+	ramAt = ram;
+	vramAt = vr;
+	aramAt = ar;
+	ctxAt = cx;
+	return moved;
+}
+#endif
 
 void Sh4Recompiler::ResetCache()
 {
+#if defined(__EMSCRIPTEN__) && HOST_CPU == CPU_GENERIC
+	// The WASM backend keeps its compiled modules. A reset discards every one, and the game then
+	// recompiles its ~2.6k blocks over the next 4-5 s (compilePC's note below): a storm that a
+	// state load brings on, and the bar's worker loads a state into a power-on machine every time
+	// players join, on every machine at once. Compiled blocks are verified against the RAM they
+	// were compiled from at dispatch (the page-generation gate, then the full-block hash), so
+	// marking every page as written makes each block re-verify once at its next dispatch, and only
+	// code that really changed is recompiled. The compiled code bakes the memory regions' addresses
+	// in, so if a region moved (a reload at another size; RamRegion keeps them put otherwise) the
+	// modules are stale and the full reset below is the only answer.
+	extern void fly_mark_all_ram_written();
+	if (!memoryRegionsMoved())
+	{
+		INFO_LOG(DYNAREC, "recSh4:Dynarec cache kept at %08X: every RAM page marked written", getContext()->pc);
+		fly_mark_all_ram_written();
+		return;
+	}
+	INFO_LOG(DYNAREC, "recSh4:Dynarec a memory region moved: the cache goes");
+#endif
 	INFO_LOG(DYNAREC, "recSh4:Dynarec Cache clear at %08X free space %d", getContext()->pc, codeBuffer.getFreeSpace());
 	codeBuffer.reset(false);
 	bm_ResetCache();
