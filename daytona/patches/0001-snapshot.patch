+rt::Inputs inputs_at(uint64_t frame) {
+    rt::Inputs in;
+    in.steer = uint8_t(0x40 + (frame * 5) % 0x80);
+    in.accel = uint8_t(0x20 + (frame * 3) % 0xc0);
+    in.in0 = uint8_t(frame % 9 == 0 ? 0xef : 0xff);
+    return in;
+}
+
+// A cable: delivers what it was given (and, looped back, what the board
+// sends), counts what is written. The same on every machine.
+struct Cable : rt::LinkTransport {
+    explicit Cable(bool loop = false) : loop(loop) {}
+    bool loop;
+    std::deque<uint8_t> in;
+    uint64_t written = 0;
+    void poll() override {}
+    bool rx_open() const override { return true; }
+    bool tx_open() const override { return true; }
+    int read(uint8_t *buf, int max) override {
+        const int n = std::min<int>(max, int(in.size()));
+        for (int i = 0; i < n; ++i) buf[i] = in.front(), in.pop_front();
+        return n;
+    }
+    bool write(const uint8_t *buf, int n) override {
+        written += uint64_t(n);
+        if (loop) in.insert(in.end(), buf, buf + n);
+        return true;
+    }
+};
+
+struct Frame {
+    uint64_t screen, raster, ram, audio, counts;
+    bool operator==(const Frame &) const = default;
+};
+
+Frame frame_of(rt::GameLoop &g) {
+    Frame f{};
+    f.screen = g.board().video().screen_hash();
+    f.raster = g.board().video().raster_hash();
+    size_t n = 0;
+    const uint8_t *ram = rt::main_ram(g.board(), &n);
+    f.ram = fnv(ram, n);
+    if (snd::SoundBoard *s = g.sound()) {
+        const auto fm = s->take_fm(), pcm = s->take_pcm();
+        f.audio = fnv(pcm.data(), pcm.size() * 4, fnv(fm.data(), fm.size() * 4)) ^ (fm.size() << 40) ^ pcm.size();
+    }
+    f.counts = g.instructions() * 3 ^ g.board().tgp().tgp_instructions() * 5 ^ uint64_t(g.interrupts()) * 7 ^
+               (g.sound() ? g.sound()->instructions() * 11 : 0) ^ g.board().sound_bytes_total() * 13;
+    return f;
+}
+
+std::vector<Frame> run(rt::GameLoop &g, uint64_t frames, uint64_t input_offset = 0) {
+    std::vector<Frame> out;
+    for (uint64_t i = 0; i < frames; ++i) {
+        g.run_frame(inputs_at(g.frames() + input_offset));
+        out.push_back(frame_of(g));
+    }
+    return out;
+}
+
+std::unique_ptr<rt::GameLoop> machine(bool sound = true, uint8_t variant = 0) {
+    return std::make_unique<rt::GameLoop>(images(variant), sound);
+}
+
+// The snapshot's integrity hash (snapshot.cpp, hash64), to make states that
+// are intact but inconsistent. Checked against a real state's first.
+uint64_t hash64(const uint8_t *p, size_t n) {
+    constexpr uint64_t k1 = 0x9e3779b97f4a7c15ull, k2 = 0xc2b2ae3d27d4eb4full;
+    uint64_t h[4] = {k1, k2, ~k1, ~k2};
+    size_t i = 0;
+    for (; i + 32 <= n; i += 32)
+        for (int l = 0; l < 4; ++l) {
+            uint64_t w;
+            std::memcpy(&w, p + i + size_t(l) * 8, 8);
+            h[l] = std::rotl(h[l] ^ (w * k2), 31) * k1;
+        }
+    uint64_t tail = 0, r = uint64_t(n);
+    for (size_t k = 0; i < n; ++i, ++k) {
+        tail |= uint64_t(p[i]) << (8 * (k & 7));
+        if ((k & 7) == 7 || i + 1 == n) r = std::rotl(r ^ (tail * k2), 31) * k1, tail = 0;
+    }
+    for (uint64_t v : h) r = std::rotl(r ^ v, 27) * k1 + k2;
+    r ^= r >> 33, r *= 0xff51afd7ed558ccdull, r ^= r >> 33, r *= 0xc4ceb9fe1a85ec53ull, r ^= r >> 33;
+    return r;
+}
+void rehash(std::vector<uint8_t> &s) {
+    const uint64_t h = hash64(s.data() + 64, s.size() - 64);
+    std::memcpy(&s[24], &h, 8);
+}
+// Offset of a section's header in a state.
+size_t section(const std::vector<uint8_t> &s, const char *tag) {
+    size_t at = 64;
+    while (at + 16 <= s.size()) {
+        if (std::memcmp(&s[at], tag, 4) == 0) return at;
+        uint64_t size;
+        std::memcpy(&size, &s[at + 8], 8);
+        at += 16 + size_t(size);
+    }
+    return SIZE_MAX;
+}
+
+double ms_since(std::chrono::steady_clock::time_point t) {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t).count();
+}
+
+} // namespace
+
+int main() {
+    constexpr uint64_t kAt = 70, kAfter = 90; // save after kAt frames; kAfter more after it
+    try {
+        // A: the straight run, saved at kAt (and, in passing, at every frame
+        // after: snapshots must not change the machine).
+        auto a = machine();
+        const std::vector<Frame> a_before = run(*a, kAt);
+        const std::vector<uint8_t> s1 = rt::save_state(*a);
+        const std::vector<uint8_t> s1_again = rt::save_state(*a);
+        check(s1 == s1_again, "two saves of one machine are the same bytes");
+
+        // B: fresh, loaded: the same bytes again, the same accessors.
+        auto b = machine();
+        check(rt::load_state(*b, s1.data(), s1.size()), "load into a fresh machine");
+        check(rt::save_state(*b) == s1, "a loaded machine saves to the same bytes");
+        {
+            rt::M2Board &x = a->board(), &y = b->board();
+            size_t n1 = 0, n2 = 0;
+            const uint8_t *r1 = rt::main_ram(x, &n1), *r2 = rt::main_ram(y, &n2);
+            bool pens = true;
+            for (uint32_t i = 0; i < 8192; ++i) pens &= x.video().system24_pen(i) == y.video().system24_pen(i);
+            check(n1 == 0x100000 && n1 == n2 && std::memcmp(r1, r2, n1) == 0, "work RAM");
+            check(a->frames() == b->frames() && a->instructions() == b->instructions() && a->interrupts() == b->interrupts() &&
+                      x.frame() == y.frame(),
+                  "frame, instruction and interrupt counts");
+            check(x.backup_ram() == y.backup_ram() && x.io().eeprom == y.io().eeprom && x.io().inputs.steer == y.io().inputs.steer &&
+                      x.sound_bytes_total() == y.sound_bytes_total(),
+                  "backup RAM, EEPROM, latched inputs, sound bytes");
+            check(x.tgp().coproctl_r() == y.tgp().coproctl_r() && x.tgp().geo_read_start() == y.tgp().geo_read_start() &&
+                      x.tgp().geo_r(0x2008 / 4) == y.tgp().geo_r(0x2008 / 4) && x.tgp().booted() && y.tgp().booted() &&
+                      x.tgp().tgp_instructions() == y.tgp().tgp_instructions() &&
+                      std::memcmp(x.tgp().buffer(), y.tgp().buffer(), 0x8000 * 4) == 0,
+                  "TGP board: control, geometrizer registers, instructions, buffer RAM");
+            check(pens && x.video().crtc_x() == y.video().crtc_x() && x.video().crtc_y() == y.video().crtc_y() &&
+                      x.video().render_x() == y.video().render_x() && x.video().render_y() == y.video().render_y() &&
+                      x.video().raster_hash() == y.video().raster_hash(),
+                  "video: pens, CRTC and render offsets, the 3D layer");
+            check(a->sound()->instructions() == b->sound()->instructions() && a->sound()->ram() == b->sound()->ram() &&
+                      a->sound()->bytes_received() == b->sound()->bytes_received(),
+                  "sound board: 68000 count and RAM, bytes received");
+        }
+        std::vector<Frame> a_after;
+        std::vector<std::vector<uint8_t>> at_30hz; // saved in 30 Hz mode (frames 80-95): one keeps its 3D layer a frame
+        for (uint64_t i = 0; i < kAfter; ++i) {
+            a_after.push_back(run(*a, 1)[0]);
+            std::vector<uint8_t> s = rt::save_state(*a);
+            if (a->frames() == 86 || a->frames() == 87) at_30hz.push_back(std::move(s));
+        }
+        // (taken from the machines' own sound buffers since the load; A's
+        // were taken at kAt by frame_of)
+        const std::vector<Frame> b_after = run(*b, kAfter);
+        check(a_after == b_after, "after a load: screen, 3D layer, work RAM, audio and counts equal, " +
+                                      std::to_string(kAfter) + " frames");
+        check(rt::save_state(*a) == rt::save_state(*b), "and the whole state at the end");
+        uint64_t polys_seen = 0;
+        for (const Frame &f : a_before) polys_seen += f.raster != a_before[0].raster;
+        check(polys_seen > 0, "the 3D layer changed over the run (the display list draws)");
+        for (const std::vector<uint8_t> &s : at_30hz) {
+            auto m = machine();
+            const bool loaded = rt::load_state(*m, s.data(), s.size());
+            const uint64_t from = m->frames();
+            check(loaded && run(*m, kAt + kAfter - from) == std::vector<Frame>(a_after.begin() + long(from - kAt), a_after.end()) &&
+                      rt::save_state(*m) == rt::save_state(*a),
+                  "saved in 30 Hz mode after frame " + std::to_string(from) + ": runs on the same, to the same state");
+        }
+
+        // Snapshots did not change A: a machine never saved runs the same.
+        auto plain = machine();
+        std::vector<Frame> plain_frames = run(*plain, kAt + kAfter);
+        check(std::equal(a_before.begin(), a_before.end(), plain_frames.begin()) &&
+                  std::equal(a_after.begin(), a_after.end(), plain_frames.begin() + kAt),
+              "saving every frame does not change the machine (YM caches included)");
+
+        // C: a machine that has been running on other inputs, loaded.
+        b.reset();
+        auto c = machine();
+        run(*c, 40, 1000);
+        check(rt::load_state(*c, s1.data(), s1.size()) && rt::save_state(*c) == s1, "load into a machine already running");
+        check(run(*c, kAfter) == std::vector<Frame>(plain_frames.begin() + kAt, plain_frames.end()),
+              "and it runs on as the original");
+        c.reset();
+
+        // Refused states leave the machine as it was.
+        auto d = machine();
+        run(*d, 5);
+        const std::vector<uint8_t> d0 = rt::save_state(*d);
+        auto refused = [&](std::vector<uint8_t> s, const std::string &what) {
+            const bool loaded = rt::load_state(*d, s.data(), s.size());
+            check(!loaded && rt::save_state(*d) == d0, "refused, machine unchanged: " + what);
+        };
+        refused({}, "empty");
+        for (size_t n : {size_t(10), size_t(63), size_t(64), size_t(100), s1.size() / 2, s1.size() - 1})
+            refused(std::vector<uint8_t>(s1.begin(), s1.begin() + long(n)), "truncated to " + std::to_string(n) + " bytes");
+        for (size_t at : {size_t(0), size_t(8), size_t(12), size_t(16), size_t(24), size_t(32), size_t(48), size_t(56)}) {
+            std::vector<uint8_t> s = s1;
+            s[at] ^= 0x01;
+            refused(s, "header byte " + std::to_string(at) + " changed");
+        }
+        int body_refused = 0;
+        for (int k = 1; k <= 64; ++k) {
+            std::vector<uint8_t> s = s1;
+            s[64 + (s.size() - 65) * size_t(k) / 64] ^= 0x10;
+            body_refused += !rt::load_state(*d, s.data(), s.size());
+        }
+        check(body_refused == 64 && rt::save_state(*d) == d0, "refused, machine unchanged: 64 single-byte corruptions spread over the body");
+        {
+            std::vector<uint8_t> s = s1;
+            s.push_back(1);
+            refused(s, "a nonzero byte after the state");
+        }
+        // Intact (rehashed) but inconsistent: refused by the section checks.
+        {
+            std::vector<uint8_t> s = s1;
+            rehash(s);
+            check(s == s1, "the test's copy of the integrity hash matches");
+            std::vector<uint8_t> t = s1;
+            t[section(t, "GEO ")] = 'X';
+            rehash(t);
+            refused(t, "a section tag changed (rehashed)");
+            t = s1;
+            const size_t vid = section(t, "VID ");
+            t[vid + 4] = 2;
+            rehash(t);
+            refused(t, "a section version changed (rehashed)");
+            t = s1;
+            const size_t ram = section(t, "RAM ");
+            le32(t, ram + 16, 0x30000); // the first RAM's size
+            rehash(t);
+            refused(t, "a RAM's size changed (rehashed)");
+            t = s1;
+            const size_t loop = section(t, "LOOP");
+            t[loop + 16 + 24] = 2; // in_vblank_: a bool that is 2
+            rehash(t);
+            refused(t, "a bool field that is 2 (rehashed)");
+            t = s1;
+            const size_t enh = section(t, "ENH ");
+            le32(t, enh + 16, 7); // draw distance 7
+            rehash(t);
+            refused(t, "draw distance out of range (rehashed)");
+        }
+        {
+            auto other = machine(true, 1); // another program image
+            const std::vector<uint8_t> o0 = rt::save_state(*other);
+            check(!rt::load_state(*other, s1.data(), s1.size()) && rt::save_state(*other) == o0,
+                  "refused, machine unchanged: another program image");
+        }
+        {
+            std::vector<uint8_t> padded = s1;
+            padded.resize(rt::state_size_bound(*a) + 100, 0);
+            auto e = machine();
+            check(rt::load_state(*e, padded.data(), padded.size()) && rt::save_state(*e) == s1, "a zero-padded buffer loads");
+        }
+        d.reset();
+
+        // A sound byte written between frames (by the host, not the game):
+        // its UART shift callback is pending across the snapshot.
+        {
+            auto u1 = machine();
+            run(*u1, 10);
+            u1->board().write_byte(0x01c80000, 0x5a);
+            const std::vector<uint8_t> us = rt::save_state(*u1);
+            uint32_t pending = 0; // LOCK: count, end, next (8 bytes each), poked (1), taken (4), then the count
+            std::memcpy(&pending, &us[section(us, "LOCK") + 16 + 29], 4);
+            auto u2 = machine();
+            check(pending == 2 && rt::load_state(*u2, us.data(), us.size()) && rt::save_state(*u2) == us,
+                  "a UART shift pending across the snapshot (two callbacks: the frame probe and the shift)");
+            const bool same = run(*u1, 10) == run(*u2, 10);
+            check(same && rt::save_state(*u1) == rt::save_state(*u2), "and it runs on the same");
+        }
+
+        // Deferred sound: no snapshot while a sound frame is pending.
+        {
+            auto e = machine();
+            e->run_frame_deferred_sound(inputs_at(0));
+            bool threw = false;
+            try {
+                (void)rt::save_state(*e);
+            } catch (const rt::Fatal &) {
+                threw = true;
+            }
+            check(threw, "save refused while a deferred sound frame is pending");
+            e->complete_deferred_sound(e->execute_deferred_sound());
+        }
+
+        // No sound board here: a state with one loads (the game is the same).
+        {
+            auto quiet = machine(false);
+            check(rt::load_state(*quiet, s1.data(), s1.size()), "a machine without a sound board takes a state with one");
+            bool same = true;
+            for (uint64_t i = 0; i < 30; ++i) {
+                const Frame f = run(*quiet, 1)[0];
+                const Frame &p = plain_frames[kAt + i];
+                same &= f.screen == p.screen && f.raster == p.raster && f.ram == p.ram;
+            }
+            check(same, "and runs on with the same screen, 3D layer and work RAM");
+            const std::vector<uint8_t> q = rt::save_state(*quiet);
+            auto loud = machine();
+            check(rt::load_state(*loud, q.data(), q.size()), "a state without a sound board loads where there is one");
+            // Nobody takes the sound bytes here: they wait in the board, and go along.
+            auto quiet2 = machine(false);
+            check(rt::load_state(*quiet2, q.data(), q.size()), "between machines without a sound board");
+            run(*quiet, 5), run(*quiet2, 5);
+            const std::vector<uint8_t> b1 = quiet->board().take_sound_bytes(), b2 = quiet2->board().take_sound_bytes();
+            check(b1 == b2 && b1.size() > 100, "their untaken sound bytes are the same (" + std::to_string(b1.size()) + ")");
+        }
+
+        // Link play: the comm board's state goes along; its presence must match.
+        {
+            // Waiting for the ring, with part of a frame in.
+            Cable ca, cb;
+            auto la = machine();
+            la->board().set_link(&ca);
+            run(*la, 3);
+            la->board().write_dword(0x01a04000, 0x00010001); // fg 1 (master), cn 1: the board starts
+            run(*la, 5);
+            // The first 300 bytes of the numbering token (0xff: cabinet 1 of 1)
+            // come before the save, the rest after.
+            ca.in.push_back(0xff), ca.in.push_back(0x01);
+            for (int i = 2; i < 300; ++i) ca.in.push_back(0);
+            run(*la, 5);
+            check(la->board().comm_board()->link() == rt::CommBoard::Link::Waiting && ca.in.empty(),
+                  "link: waiting for the ring, part of a frame received");
+            const std::vector<uint8_t> ls = rt::save_state(*la);
+            auto lb = machine();
+            lb->board().set_link(&cb);
+            check(rt::load_state(*lb, ls.data(), ls.size()) && rt::save_state(*lb) == ls, "link: loads where there is a link");
+            for (Cable *k : {&ca, &cb})
+                for (int i = 300; i < 0xe01; ++i) k->in.push_back(0);
+            const bool same = run(*la, 20) == run(*lb, 20);
+            check(same && rt::save_state(*la) == rt::save_state(*lb) && lb->board().comm_board()->link() == rt::CommBoard::Link::Up,
+                  "link: and runs on the same (the token completes, the link comes up)");
+            auto none = machine();
+            const std::vector<uint8_t> n0 = rt::save_state(*none);
+            check(!rt::load_state(*none, ls.data(), ls.size()) && rt::save_state(*none) == n0, "link: refused where there is none");
+            Cable cc;
+            auto linked = machine();
+            linked->board().set_link(&cc);
+            check(!rt::load_state(*linked, s1.data(), s1.size()), "link: a state without one refused where there is one");
+        }
+        {
+            // Up: a ring of one (the cable looped back), a frame each way every vblank.
+            Cable ca(true), cb(true);
+            auto la = machine();
+            la->board().set_link(&ca);
+            run(*la, 3);
+            la->board().write_dword(0x01a04000, 0x00010001);
+            for (int i = 0; i < 400 && la->board().comm_board()->link() != rt::CommBoard::Link::Up; ++i) run(*la, 1);
+            run(*la, 3);
+            const rt::CommBoard &up = *la->board().comm_board();
+            check(up.link() == rt::CommBoard::Link::Up && up.id() == 1 && up.count() == 1 && ca.in.empty(),
+                  "link: up after " + std::to_string(la->frames()) + " frames, cabinet 1 of 1, nothing left on the line");
+            const std::vector<uint8_t> ls = rt::save_state(*la);
+            const uint64_t written = ca.written;
+            auto lb = machine();
+            lb->board().set_link(&cb);
+            check(rt::load_state(*lb, ls.data(), ls.size()), "link up: loads");
+            const bool same = run(*la, 30) == run(*lb, 30);
+            check(same && rt::save_state(*la) == rt::save_state(*lb) && ca.written - written == cb.written && cb.written > 0,
+                  "link up: runs on the same, sending the same bytes (" + std::to_string(cb.written) + ")");
+        }
+
+        // Size and cost.
+        {
+            auto m = machine();
+            run(*m, kAt);
+            std::vector<uint8_t> s;
+            const int reps = 20;
+            auto t0 = std::chrono::steady_clock::now();
+            for (int i = 0; i < reps; ++i) s = rt::save_state(*m);
+            const double save_ms = ms_since(t0) / reps;
+            t0 = std::chrono::steady_clock::now();
+            for (int i = 0; i < reps; ++i) (void)rt::load_state(*m, s.data(), s.size());
+            const double load_ms = ms_since(t0) / reps;
+            std::printf("state: %zu bytes (bound %zu); save %.2f ms, load %.2f ms (mean of %d)\n", s.size(),
+                        rt::state_size_bound(*m), save_ms, load_ms, reps);
+            size_t at = 64;
+            while (at + 16 <= s.size()) {
+                uint64_t size;
+                std::memcpy(&size, &s[at + 8], 8);
+                std::printf("  %.4s %9llu\n", reinterpret_cast<const char *>(&s[at]), (unsigned long long)size);
+                at += 16 + size_t(size);
+            }
+            check(s.size() <= rt::state_size_bound(*m), "the state fits its bound");
+        }
+    } catch (const std::exception &e) {
+        std::printf("FAIL: exception: %s\n", e.what());
+        return 1;
+    }
+    std::printf("%s\n", failures ? "test_snapshot: FAILED" : "test_snapshot: all passed");
+    return failures ? 1 : 0;
+}
diff --git a/tests/test_snapshot_rom.cpp b/tests/test_snapshot_rom.cpp
new file mode 100644
index 0000000..02a242d
--- /dev/null
+++ b/tests/test_snapshot_rom.cpp
@@ -0,0 +1,260 @@
+// Snapshots on the real game (needs the imported images and the generated
+// code): a run saved at each sample point, each state loaded into a fresh
+// GameLoop and run on, held frame by frame to a straight run that never
+// saved: the screen, the 3D layer, the work RAM, the sound board's output and
+// the instruction counts; and the whole state at the end of each stretch to
+// the saving run's own. Prints the state's size and the save and load times.
+//
+//   test_snapshot_rom IMAGES_DIR [--inputs FILE] [--at N,N,...] [--then K]
+//                     [--nvram DIR] [--loop-link]
+//
+// --nvram DIR: every machine starts from the app's saved EEPROM and backup
+// RAM (tools/common/nvram.h). --loop-link: every machine has the comm board,
+// its cable looped back (a ring of one cabinet: Revision A's factory
+// settings, a linked master, then run as "1 of 1"). Bytes on that cable are
+// the host's, not the machine's: a loaded machine's cable gets what the
+// saving machine's held at that frame, as a host would hand them over.
+//
+// Exit 0 when every point holds, 1 when one does not, 77 (skipped) without
+// the images.
+
+#include "runtime/snapshot.h"
+#include "../tools/common/input_script.h"
+#include "../tools/common/nvram.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace {
+
+// A cable from the comm board back to itself, delivering at once.
+struct Loop : rt::LinkTransport {
+    std::deque<uint8_t> in;
+    void poll() override {}
+    bool rx_open() const override { return true; }
+    bool tx_open() const override { return true; }
+    int read(uint8_t *buf, int max) override {
+        const int n = std::min<int>(max, int(in.size()));
+        for (int i = 0; i < n; ++i) buf[i] = in.front(), in.pop_front();
+        return n;
+    }
+    bool write(const uint8_t *buf, int n) override {
+        in.insert(in.end(), buf, buf + n);
+        return true;
+    }
+};
+
+// A machine as the options make it.
+struct Machine {
+    Loop cable;
+    std::unique_ptr<rt::GameLoop> game;
+    Machine(const std::string &dir, const std::string &nvram, bool link) : game(std::make_unique<rt::GameLoop>(dir)) {
+        if (!nvram.empty()) tools::load_nvram(*game, nvram);
+        if (link) game->board().set_link(&cable);
+    }
+};
+
+uint64_t fnv(const void *p, size_t n, uint64_t h = 0xcbf29ce484222325ull) {
+    const auto *b = static_cast<const uint8_t *>(p);
+    for (size_t i = 0; i < n; ++i) h = (h ^ b[i]) * 0x100000001b3ull;
+    return h;
+}
+
+struct Frame {
+    uint64_t screen = 0, raster = 0, ram = 0, audio = 0, instructions = 0, tgp = 0, sound = 0;
+    bool operator==(const Frame &) const = default;
+};
+
+Frame frame_of(rt::GameLoop &g) {
+    Frame f;
+    f.screen = g.board().video().screen_hash();
+    f.raster = g.board().video().raster_hash();
+    size_t n = 0;
+    const uint8_t *ram = rt::main_ram(g.board(), &n);
+    f.ram = fnv(ram, n);
+    if (snd::SoundBoard *s = g.sound()) {
+        const auto fm = s->take_fm(), pcm = s->take_pcm();
+        f.audio = fnv(pcm.data(), pcm.size() * sizeof(float), fnv(fm.data(), fm.size() * sizeof(float)));
+        f.sound = s->instructions();
+    }
+    f.instructions = g.instructions();
+    f.tgp = g.board().tgp().tgp_instructions();
+    return f;
+}
+
+// The parts that differ, as bits: screen, 3D layer, work RAM, audio, i960,
+// TGP and 68000 counts.
+unsigned differences(const Frame &a, const Frame &b) {
+    return (a.screen != b.screen) | (a.raster != b.raster) << 1 | (a.ram != b.ram) << 2 | (a.audio != b.audio) << 3 |
+           (a.instructions != b.instructions) << 4 | (a.tgp != b.tgp) << 5 | (a.sound != b.sound) << 6;
+}
+std::string names(unsigned d) {
+    static const char *name[] = {"screen", "3D-layer", "work-RAM", "audio", "i960-count", "TGP-count", "68000-count"};
+    std::string s;
+    for (unsigned i = 0; i < 7; ++i)
+        if (d >> i & 1) s += std::string(" ") + name[i];
+    return s;
+}
+
+double ms(std::chrono::steady_clock::time_point t) {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t).count();
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+    if (argc < 2) {
+        std::fprintf(stderr, "usage: test_snapshot_rom IMAGES_DIR [--inputs FILE] [--at N,N,...] [--then K]\n");
+        return 2;
+    }
+    const std::string dir = argv[1];
+    if (!std::ifstream(dir + "/program.bin")) {
+        std::printf("test_snapshot_rom: no images at %s (import the ROM set first): skipped\n", dir.c_str());
+        return 77;
+    }
+    std::vector<uint64_t> points = {600, 1300, 2000, 3000, 4000};
+    uint64_t then = 300;
+    tools::Script script;
+    std::string nvram;
+    bool link = false;
+    for (int i = 2; i < argc; ++i)
+        if (!std::strcmp(argv[i], "--loop-link")) link = true;
+    for (int i = 2; i + 1 < argc; i += 2) {
+        if (!std::strcmp(argv[i], "--loop-link")) {
+            --i;
+            continue;
+        }
+        if (!std::strcmp(argv[i], "--inputs")) script.load(argv[i + 1]);
+        else if (!std::strcmp(argv[i], "--nvram")) nvram = argv[i + 1];
+        else if (!std::strcmp(argv[i], "--then")) then = std::strtoull(argv[i + 1], nullptr, 10);
+        else if (!std::strcmp(argv[i], "--at")) {
+            points.clear();
+            std::stringstream ss(argv[i + 1]);
+            for (std::string n; std::getline(ss, n, ',');) points.push_back(std::strtoull(n.c_str(), nullptr, 10));
+        }
+    }
+    std::sort(points.begin(), points.end());
+    const uint64_t last = points.back() + then;
+    int failures = 0;
+    try {
+        // The reference: never saved.
+        auto t0 = std::chrono::steady_clock::now();
+        std::vector<Frame> reference;
+        {
+            Machine m(dir, nvram, link);
+            rt::GameLoop &g = *m.game;
+            for (uint64_t f = 0; f < last; ++f) {
+                g.run_frame(script.at(g.board().frame()));
+                reference.push_back(frame_of(g));
+            }
+        }
+        const double ref_ms = ms(t0);
+        std::printf("reference: %" PRIu64 " frames in %.1f s\n", last, ref_ms / 1000);
+
+        // The saving run: states at each point and at the end of each stretch.
+        std::map<uint64_t, std::vector<uint8_t>> states;
+        std::map<uint64_t, std::deque<uint8_t>> cables;
+        double save_ms = 0, bound = 0;
+        int saves = 0;
+        size_t cable_max = 0;
+        {
+            Machine m(dir, nvram, link);
+            rt::GameLoop &g = *m.game;
+            bool same = true;
+            for (uint64_t f = 0; f < last; ++f) {
+                g.run_frame(script.at(g.board().frame()));
+                const Frame fr = frame_of(g);
+                if (!(fr == reference[f]) && same) {
+                    std::printf("FAIL: the saving run left the reference at frame %" PRIu64 ":%s\n", f + 1,
+                                names(differences(fr, reference[f])).c_str());
+                    same = false;
+                    ++failures;
+                }
+                const uint64_t n = g.frames();
+                bool wanted = false;
+                for (uint64_t p : points) wanted |= n == p || n == p + then;
+                // a save every 50 frames too: saving must not change the machine
+                if (wanted || n % 50 == 0) {
+                    const auto t = std::chrono::steady_clock::now();
+                    std::vector<uint8_t> s = rt::save_state(g);
+                    save_ms += ms(t), ++saves;
+                    bound = double(rt::state_size_bound(g));
+                    if (wanted) states[n] = std::move(s), cables[n] = m.cable.in;
+                    cable_max = std::max(cable_max, m.cable.in.size());
+                }
+            }
+            if (link) {
+                const rt::CommBoard *cb = g.board().comm_board();
+                static const char *names[] = {"off", "waiting", "up", "lost"};
+                std::printf("link: %s, cabinet %d of %d; most bytes on the cable at a save: %zu\n", names[int(cb->link())],
+                            cb->id(), cb->count(), cable_max);
+            }
+            if (same) std::printf("ok  : saving (%d states) left the run as the reference, %" PRIu64 " frames\n", saves, last);
+        }
+
+        // Each point: loaded into a fresh GameLoop, run on.
+        double load_ms = 0;
+        int loads = 0;
+        for (uint64_t p : points) {
+            const std::vector<uint8_t> &s = states.at(p);
+            Machine m(dir, nvram, link);
+            rt::GameLoop &g = *m.game;
+            m.cable.in = cables.at(p); // the host's bytes in flight
+            const auto t = std::chrono::steady_clock::now();
+            const bool loaded = rt::load_state(g, s.data(), s.size());
+            load_ms += ms(t), ++loads;
+            if (!loaded) {
+                std::printf("FAIL: the state at frame %" PRIu64 " did not load\n", p);
+                ++failures;
+                continue;
+            }
+            const bool resaved = rt::save_state(g) == s;
+            uint64_t bad = 0, first_bad = 0;
+            unsigned what = 0;
+            for (uint64_t k = 0; k < then; ++k) {
+                g.run_frame(script.at(g.board().frame()));
+                const Frame fr = frame_of(g);
+                const Frame &ref = reference[p + k];
+                if (const unsigned d = differences(fr, ref)) {
+                    if (!bad++) first_bad = p + k + 1;
+                    what |= d;
+                }
+            }
+            const bool end_same = rt::save_state(g) == states.at(p + then);
+            const bool ok = resaved && !bad && end_same;
+            failures += !ok;
+            std::printf("%s: frame %5" PRIu64 ": %zu bytes; loaded saves the same bytes: %s; %" PRIu64
+                        " frames after: %" PRIu64 " differ%s%s; whole state at frame %" PRIu64 ": %s\n",
+                        ok ? "ok  " : "FAIL", p, s.size(), resaved ? "yes" : "NO", then, bad,
+                        bad ? (" (from frame " + std::to_string(first_bad) + "; in:").c_str() : "", bad ? (names(what) + ")").c_str() : "",
+                        p + then, end_same ? "same" : "DIFFERENT");
+        }
+
+        const std::vector<uint8_t> &s = states.at(points.back());
+        std::printf("state size: %zu bytes (bound %.0f); save %.2f ms (mean of %d), load %.2f ms (mean of %d, into a fresh GameLoop)\n",
+                    s.size(), bound, save_ms / saves, saves, load_ms / loads, loads);
+        size_t at = 64;
+        while (at + 16 <= s.size()) {
+            uint64_t size;
+            std::memcpy(&size, &s[at + 8], 8);
+            std::printf("  %.4s %9" PRIu64 "\n", reinterpret_cast<const char *>(&s[at]), size);
+            at += 16 + size_t(size);
+        }
+    } catch (const std::exception &e) {
+        std::printf("FAIL: %s\n", e.what());
+        return 1;
+    }
+    std::printf("%s\n", failures ? "test_snapshot_rom: FAILED" : "test_snapshot_rom: all passed");
+    return failures ? 1 : 0;
+}
