+Result CBlockFile::CreateFromFile(FILE *file, const std::string &headerName, const std::string &comment)
+{
+  fp = file; ownFp = false;
+  if (NULL == fp) return Result::FAIL;
+  mode = 'w';
+  WriteBlockHeader(headerName, comment);
+  return Result::OKAY;
+}
+
+Result CBlockFile::LoadFromFile(FILE *file)
+{
+  fp = file; ownFp = false;
+  if (NULL == fp) return Result::FAIL;
+  mode = 'r';
+  fseek(fp, 0, SEEK_END); fileSize = ftell(fp); fseek(fp, 0, SEEK_SET);
+  return Result::OKAY;
+}
+
