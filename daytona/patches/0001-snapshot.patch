diff --git a/src/runtime/snapshot.cpp b/src/runtime/snapshot.cpp
new file mode 100644
index 0000000..bde1925
--- /dev/null
+++ b/src/runtime/snapshot.cpp
@@ -0,0 +1,816 @@
+// Snapshots of the machine (see snapshot.h). One description of each part's
+// fields serves both directions: a Writer appends them, a Reader reads them
+// back, first only checking (nothing is written) and then, if the whole
+// state checked out, applying.
+
+#include "runtime/snapshot.h"
+
+#include <algorithm>
+#include <bit>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <string>
+#include <type_traits>
+#include <utility>
+
+#if defined(M2_DC_MEMORY) || defined(M2_DC_SPEED)
+#error "snapshots do not cover the Dreamcast build's memory layout and fast paths"
+#endif
+
+static_assert(std::endian::native == std::endian::little, "snapshots are little-endian, as every host this builds for");
+static_assert(sizeof(int) == 4, "int fields are saved as 32 bits");
+
+// ymfm's save_restore leaves three of its engine's counters out: which
+// channels are summed into the output (refreshed every 4096 samples) and the
+// schedule of those refreshes. Without them a loaded chip sums its channels
+// differently for up to 4096 samples. They are reached through pointers to
+// members named in explicit instantiations, where access is not checked
+// ([temp.spec.general]: "The usual access checking rules do not apply to
+// names used to specify explicit instantiations"); ymfm itself is unchanged.
+namespace rt::ymfm_access {
+template <typename Tag, typename Tag::type M> struct Expose {
+    friend typename Tag::type member(Tag) { return M; }
+};
+using Engine = ymfm::fm_engine_base<ymfm::opna_registers>;
+struct Fm { using type = Engine ymfm::ym2612::*; friend type member(Fm); };
+struct Active { using type = uint32_t Engine::*; friend type member(Active); };
+struct Modified { using type = uint32_t Engine::*; friend type member(Modified); };
+struct Prepare { using type = uint32_t Engine::*; friend type member(Prepare); };
+template struct Expose<Fm, &ymfm::ym2612::m_fm>;
+template struct Expose<Active, &Engine::m_active_channels>;
+template struct Expose<Modified, &Engine::m_modified_channels>;
+template struct Expose<Prepare, &Engine::m_prepare_count>;
+} // namespace rt::ymfm_access
+
+namespace rt {
+
+namespace {
+
+constexpr char kMagic[8] = {'M', '2', 'S', 'N', 'A', 'P', 'S', 'T'};
+constexpr uint32_t kVersion = 1, kHeaderSize = 64, kSectionHeader = 16;
+
+// Limits for state_size_bound only (a load takes any count its section's
+// size allows): far above anything seen.
+constexpr size_t kBoundPolys = 8192;        // kept polygons in a frame (attract and race: 2,182)
+constexpr size_t kBoundFifoWords = 65536;   // each TGP FIFO
+constexpr size_t kBoundUartBytes = 65536;   // bytes for the sound board not yet taken
+constexpr size_t kBoundSoundEvents = 65536; // sound board events (bytes on the line, YM timers)
+constexpr size_t kBoundCallbacks = 64;      // i960 callbacks (the frame probe, a UART shift)
+constexpr size_t kMaxPolys = 32768;         // MAME MAX_POLYGONS: Geo stops there
+
+constexpr uint32_t fourcc(const char (&s)[5]) {
+    return uint32_t(uint8_t(s[0])) | uint32_t(uint8_t(s[1])) << 8 | uint32_t(uint8_t(s[2])) << 16 |
+           uint32_t(uint8_t(s[3])) << 24;
+}
+
+// A check against truncation and corruption, not a cryptographic hash: four
+// lanes of multiply-rotate over 8-byte words, each step a bijection of the
+// lane, so any single changed word changes the result.
+uint64_t hash64(const uint8_t *p, size_t n) {
+    constexpr uint64_t k1 = 0x9e3779b97f4a7c15ull, k2 = 0xc2b2ae3d27d4eb4full;
+    uint64_t h[4] = {k1, k2, ~k1, ~k2};
+    size_t i = 0;
+    for (; i + 32 <= n; i += 32)
+        for (int l = 0; l < 4; ++l) {
+            uint64_t w;
+            std::memcpy(&w, p + i + size_t(l) * 8, 8);
+            h[l] = std::rotl(h[l] ^ (w * k2), 31) * k1;
+        }
+    uint64_t tail = 0, r = uint64_t(n);
+    for (size_t k = 0; i < n; ++i, ++k) {
+        tail |= uint64_t(p[i]) << (8 * (k & 7));
+        if ((k & 7) == 7 || i + 1 == n) r = std::rotl(r ^ (tail * k2), 31) * k1, tail = 0;
+    }
+    for (uint64_t v : h) r = std::rotl(r ^ v, 27) * k1 + k2;
+    r ^= r >> 33, r *= 0xff51afd7ed558ccdull, r ^= r >> 33, r *= 0xc4ceb9fe1a85ec53ull, r ^= r >> 33;
+    return r;
+}
+
+// --- the two directions ---------------------------------------------------------
+
+class Writer {
+public:
+    static constexpr bool kSaving = true;
+    explicit Writer(std::vector<uint8_t> &out) : out_(out) {}
+    bool ok() const { return true; }
+    bool apply() const { return false; }
+    template <typename T> T operator()(const T &v) {
+        static_assert(std::is_arithmetic_v<T> && sizeof(T) <= 8);
+        if constexpr (std::is_same_v<T, bool>) out_.push_back(v ? 1 : 0);
+        else put(&v, sizeof v);
+        return v;
+    }
+    template <typename E> E en(const E &v, E max) { // an enum (u8)
+        (void)max;
+        out_.push_back(uint8_t(v));
+        return v;
+    }
+    void raw(const void *p, size_t n) { put(p, n); }
+    template <typename T, size_t N> void arr(const T (&a)[N]) {
+        static_assert(std::is_arithmetic_v<T> && !std::is_same_v<T, bool>);
+        put(a, sizeof a);
+    }
+    // A vector of up to `max` elements; a vector whose length the target
+    // must share.
+    template <typename T> void vec(const std::vector<T> &v, size_t max = SIZE_MAX) {
+        require(v.size() <= max && v.size() <= UINT32_MAX, "a queue past its limit");
+        (*this)(uint32_t(v.size()));
+        put(v.data(), v.size() * sizeof(T));
+    }
+    template <typename T> void fixed(const std::vector<T> &v) { vec(v); }
+    uint32_t count(uint32_t n, size_t) { return (*this)(n); }
+    bool require(bool ok, const char *what) {
+        if (!ok) throw Fatal(std::string("snapshot: cannot save: ") + what);
+        return true;
+    }
+    template <typename F> void section(const char (&tag)[5], uint32_t version, F &&body) {
+        (*this)(fourcc(tag));
+        (*this)(version);
+        const size_t at = out_.size();
+        (*this)(uint64_t(0));
+        body();
+        const uint64_t size = out_.size() - at - 8;
+        std::memcpy(out_.data() + at, &size, 8);
+    }
+
+private:
+    void put(const void *p, size_t n) {
+        const auto *b = static_cast<const uint8_t *>(p);
+        out_.insert(out_.end(), b, b + n);
+    }
+    std::vector<uint8_t> &out_;
+};
+
+class Reader {
+public:
+    static constexpr bool kSaving = false;
+    Reader(const uint8_t *p, size_t n, bool apply) : p_(p), end_(p + n), apply_(apply) {}
+    bool ok() const { return ok_; }
+    bool apply() const { return apply_; }
+    bool at_end() const { return p_ == end_; }
+    // Reads a field, stores it only when applying; returns what was read.
+    template <typename T> T operator()(T &v) {
+        static_assert(std::is_arithmetic_v<T> && sizeof(T) <= 8);
+        const T t = get<T>();
+        if (apply_ && ok_) v = t;
+        return t;
+    }
+    template <typename T> T get() {
+        if constexpr (std::is_same_v<T, bool>) {
+            const uint8_t b = get<uint8_t>();
+            require(b <= 1, "bool");
+            return b != 0;
+        } else {
+            T t{};
+            if (need(sizeof t)) {
+                std::memcpy(&t, p_, sizeof t);
+                p_ += sizeof t;
+            }
+            return t;
+        }
+    }
+    template <typename E> E en(E &v, E max) {
+        const uint8_t u = get<uint8_t>();
+        require(u <= uint8_t(max), "enum");
+        if (apply_ && ok_) v = E(u);
+        return E(u);
+    }
+    void raw(void *p, size_t n) {
+        if (!need(n)) return;
+        if (apply_) std::memcpy(p, p_, n);
+        p_ += n;
+    }
+    template <typename T, size_t N> void arr(T (&a)[N]) {
+        static_assert(std::is_arithmetic_v<T> && !std::is_same_v<T, bool>);
+        raw(a, sizeof a);
+    }
+    template <typename T> void vec(std::vector<T> &v, size_t max = SIZE_MAX) {
+        const uint32_t n = count(0, sizeof(T));
+        if (!require(n <= max, "a queue past its limit")) return;
+        if (apply_) v.resize(n);
+        raw(v.data(), size_t(n) * sizeof(T));
+    }
+    void skip(size_t n) {
+        if (need(n)) p_ += n;
+    }
+    template <typename T> void fixed(std::vector<T> &v) {
+        const uint32_t n = get<uint32_t>();
+        if (require(n == v.size(), "size")) raw(v.data(), size_t(n) * sizeof(T));
+    }
+    // A count of elements of at least `min_bytes` each, which must fit in
+    // what is left of the section.
+    uint32_t count(uint32_t, size_t min_bytes) {
+        const uint32_t n = get<uint32_t>();
+        require(uint64_t(n) * min_bytes <= uint64_t(end_ - p_), "count");
+        return ok_ ? n : 0;
+    }
+    bool require(bool ok, const char *) {
+        if (!ok) fail();
+        return ok_;
+    }
+    template <typename F> void section(const char (&tag)[5], uint32_t version, F &&body) {
+        const uint32_t t = get<uint32_t>(), v = get<uint32_t>();
+        const uint64_t size = get<uint64_t>();
+        if (!require(t == fourcc(tag) && v == version && size <= uint64_t(end_ - p_), "section")) return;
+        const uint8_t *const outer = end_;
+        end_ = p_ + size;
+        body();
+        require(p_ == end_, "section size");
+        p_ = end_;
+        end_ = outer;
+    }
+    void skip_section_rest() { p_ = end_; }
+
+private:
+    bool need(size_t n) {
+        if (ok_ && size_t(end_ - p_) >= n) return true;
+        fail();
+        return false;
+    }
+    void fail() {
+        ok_ = false;
+        p_ = end_;
+    }
+    const uint8_t *p_, *end_;
+    bool apply_, ok_ = true;
+};
+
+} // namespace
+
+// --- the parts --------------------------------------------------------------------
+
+class SnapshotAccess {
+public:
+    template <class Ar> static void state(Ar &ar, GameLoop &g);
+    static size_t bound(const GameLoop &g);
+    static uint8_t *work_ram(M2Board &b, size_t *size) {
+        if (size) *size = b.work_.size();
+        return b.work_.data();
+    }
+    static const M2Board::Images &images(const GameLoop &g) { return g.board_->img_; }
+    static bool sound_pending(const GameLoop &g) { return g.sound_frame_pending_; }
+    static void loaded(GameLoop &g);
+
+private:
+    template <class Ar> static void loop(Ar &ar, GameLoop &g);
+    template <class Ar> static void cpu(Ar &ar, Cpu &c);
+    template <class Ar> static void lockstep(Ar &ar, GameLoop &g);
+    template <class Ar> static void enhance(Ar &ar);
+    template <class Ar> static void board(Ar &ar, M2Board &b);
+    template <class Ar> static void rams(Ar &ar, M2Board &b);
+    template <class Ar> static void io(Ar &ar, IoBoard &io);
+    template <class Ar> static void tgp_board(Ar &ar, TgpBoard &t);
+    template <class Ar> static void tgp(Ar &ar, Tgp &t);
+    template <class Ar> static void geo(Ar &ar, Geo &g);
+    template <class Ar> static void video(Ar &ar, Video &v);
+    template <class Ar> static void comm(Ar &ar, M2Board &b);
+    template <class Ar> static void sound(Ar &ar, snd::SoundBoard *s);
+    template <class Ar> static void ym(Ar &ar, snd::SoundBoard *s);
+    template <class Ar> static void pcm(Ar &ar, snd::SoundBoard *s, int chip);
+    template <class Ar> static void fifo(Ar &ar, std::deque<uint32_t> &q);
+    template <class Ar> static void vertex(Ar &ar, GeoVertex &v);
+    template <class Ar> static bool present(Ar &ar, bool here);
+};
+
+template <class Ar> void SnapshotAccess::state(Ar &ar, GameLoop &g) {
+    M2Board &b = *g.board_;
+    ar.section("LOOP", 1, [&] { loop(ar, g); });
+    ar.section("CPU ", 1, [&] { cpu(ar, *g.cpu_); });
+    ar.section("LOCK", 1, [&] { lockstep(ar, g); });
+    ar.section("ENH ", 1, [&] { enhance(ar); });
+    ar.section("BRD ", 1, [&] { board(ar, b); });
+    ar.section("RAM ", 1, [&] { rams(ar, b); });
+    ar.section("IO  ", 1, [&] { io(ar, b.io_); });
+    ar.section("TGPB", 1, [&] { tgp_board(ar, b.tgp_); });
+    ar.section("TGP ", 1, [&] { tgp(ar, b.tgp_.tgp_); });
+    ar.section("GEO ", 1, [&] { geo(ar, *b.geo_); });
+    ar.section("VID ", 1, [&] { video(ar, *b.video_); });
+    ar.section("COMM", 1, [&] { comm(ar, b); });
+    ar.section("SND ", 1, [&] { sound(ar, g.sound_.get()); });
+    ar.section("YM  ", 1, [&] { ym(ar, g.sound_.get()); });
+    ar.section("PCM1", 1, [&] { pcm(ar, g.sound_.get(), 0); });
+    ar.section("PCM2", 1, [&] { pcm(ar, g.sound_.get(), 1); });
+    ar.section("END ", 1, [] {});
+}
+
+template <class Ar> void SnapshotAccess::loop(Ar &ar, GameLoop &g) {
+    ar(g.frames_);
+    ar(g.frame_start_);
+    ar(g.vblank_start_);
+    ar(g.in_vblank_);
+    ar(g.frame_done_);
+    Inputs &in = g.inputs_;
+    ar(in.steer), ar(in.accel), ar(in.brake), ar(in.in0), ar(in.in1), ar(in.in2);
+}
+
+template <class Ar> void SnapshotAccess::cpu(Ar &ar, Cpu &c) {
+    ar.arr(c.m_r);
+    ar.raw(c.m_rcache, sizeof c.m_rcache);
+    ar.arr(c.m_rcache_frame_addr);
+    ar.require(ar(c.m_rcache_pos) >= 0, "register cache position");
+    ar.arr(c.m_fp); // doubles: their bits
+    ar(c.m_SAT), ar(c.m_PRCB), ar(c.m_PC), ar(c.m_AC), ar(c.m_IP), ar(c.m_PIP), ar(c.m_ICR);
+    ar(c.m_immediate_irq), ar(c.m_immediate_vector), ar(c.m_immediate_pri);
+    ar.arr(c.m_irq_line_state);
+}
+
+// The pending free-run callbacks, by tag, in the order they will run.
+template <class Ar> void SnapshotAccess::lockstep(Ar &ar, GameLoop &g) {
+    Lockstep &ls = *g.ls_;
+    ar.require(ls.free_run_, "the lockstep harness (a MAME log) has no snapshots");
+    ar(ls.count), ar(ls.end_count), ar(ls.next_count), ar(ls.poked_), ar(ls.taken_);
+    using Callback = Lockstep::Callback;
+    if constexpr (Ar::kSaving) {
+        ar(uint32_t(ls.log_.size() - ls.next_));
+        for (size_t i = ls.next_; i < ls.log_.size(); ++i) {
+            const Lockstep::Event &e = ls.log_[i];
+            ar.require(e.kind == Lockstep::Event::Call && e.tag != Callback::Untagged,
+                       "a callback no snapshot knows is pending (a tool's own)");
+            ar(e.count);
+            ar.en(e.tag, Callback::UartShift);
+        }
+    } else {
+        const uint32_t n = ar.count(0, 9);
+        std::vector<std::pair<uint64_t, Callback>> events;
+        uint64_t last = 0;
+        for (uint32_t i = 0; i < n && ar.ok(); ++i) {
+            const uint64_t at = ar.template get<uint64_t>();
+            Callback unused = Callback::Untagged;
+            const Callback tag = ar.en(unused, Callback::UartShift);
+            ar.require(tag != Callback::Untagged, "untagged callback");
+            ar.require(at >= last, "callbacks out of order");
+            last = at;
+            events.emplace_back(at, tag);
+        }
+        if (!ar.apply() || !ar.ok()) return;
+        ls.log_.clear();
+        ls.calls_.clear();
+        ls.next_ = 0;
+        for (const auto &[at, tag] : events) {
+            Lockstep::Event e{};
+            e.kind = Lockstep::Event::Call;
+            e.count = at;
+            e.fn = ls.calls_.size();
+            e.tag = tag;
+            ls.calls_.push_back(tag == Callback::FrameProbe ? g.probe_fn() : g.board_->uart_shift_fn());
+            ls.log_.push_back(e);
+        }
+    }
+}
+
+template <class Ar> void SnapshotAccess::enhance(Ar &ar) {
+    const int level = ar(Enhance::draw_distance);
+    ar.require(level >= Enhance::kDrawMin && level <= Enhance::kDrawMax, "draw distance");
+    ar(Enhance::budget_raised);
+}
+
+template <class Ar> void SnapshotAccess::board(Ar &ar, M2Board &b) {
+    ar(b.intreq_), ar(b.intena_);
+    ar.arr(b.lines_);
+    ar.arr(b.timervals_);
+    ar(b.videocontrol_), ar(b.zclip_);
+    ar(b.render_mode_), ar(b.render_test_), ar(b.render_unk_);
+    ar(b.comm_cn_), ar(b.comm_fg_);
+    ar(b.frame_);
+    ar(b.uart_txrdy_), ar(b.uart_shift_busy_), ar(b.uart_have_hold_), ar(b.uart_hold_);
+    ar.vec(b.uart_out_);
+    ar(b.sound_total_);
+}
+
+template <class Ar> void SnapshotAccess::rams(Ar &ar, M2Board &b) {
+    for (std::vector<uint8_t> *r : {&b.ram_, &b.work_, &b.cpuctl_, &b.backup_, &b.tile_, &b.chr_, &b.palette_, &b.xlat_,
+                                    &b.tex0_, &b.tex1_, &b.luma_, &b.fb_a_, &b.fb_b_, &b.comm_})
+        ar.fixed(*r);
+}
+
+template <class Ar> void SnapshotAccess::io(Ar &ar, IoBoard &io) {
+    ar.raw(io.ram_.data(), io.ram_.size());
+    ar.raw(io.eeprom.data(), io.eeprom.size());
+    Inputs &in = io.inputs;
+    ar(in.steer), ar(in.accel), ar(in.brake), ar(in.in0), ar(in.in1), ar(in.in2);
+}
+
+template <class Ar> void SnapshotAccess::fifo(Ar &ar, std::deque<uint32_t> &q) {
+    if constexpr (Ar::kSaving) {
+        ar(uint32_t(q.size()));
+        for (uint32_t w : q) ar(w);
+    } else {
+        const uint32_t n = ar.count(0, 4);
+        if (ar.apply() && ar.ok()) q.clear();
+        for (uint32_t i = 0; i < n && ar.ok(); ++i) {
+            const uint32_t w = ar.template get<uint32_t>();
+            if (ar.apply()) q.push_back(w);
+        }
+    }
+}
+
+template <class Ar> void SnapshotAccess::tgp_board(Ar &ar, TgpBoard &t) {
+    fifo(ar, t.in_);
+    fifo(ar, t.out_);
+    ar.vec(t.upload_, 0x1000); // (fifo_w's limit)
+    ar(t.coproctl_), ar(t.geoctl_), ar(t.geo_write_start_), ar(t.geo_read_start_);
+    ar(t.booted_);
+    ar.arr(t.buffer_);
+}
+
+template <class Ar> void SnapshotAccess::tgp(Ar &ar, Tgp &t) {
+    ar(t.st), ar(t.a), ar(t.b), ar(t.d), ar(t.p);
+    ar(t.alu_stmask), ar(t.alu_stset), ar(t.alu_r1), ar(t.alu_r2);
+    ar(t.pc), ar(t.sp), ar(t.b0), ar(t.b1), ar(t.x0), ar(t.x1), ar(t.i0), ar(t.i1), ar(t.vsmr);
+    ar.arr(t.pcs);
+    ar(t.mask), ar(t.m);
+    ar(t.r), ar(t.rpc), ar(t.c0), ar(t.c1), ar(t.sft), ar(t.vsm);
+    ar(t.gpio0), ar(t.stall);
+    ar(t.count);
+    ar(t.bank_reg), ar(t.sincos_base), ar(t.inv_base), ar(t.isqrt_base);
+    ar.arr(t.atan_base);
+    ar.arr(t.data);
+    ar.arr(t.prog);
+}
+
+template <class Ar> void SnapshotAccess::vertex(Ar &ar, GeoVertex &v) {
+    ar(v.x), ar(v.y);
+    ar.arr(v.p);
+}
+
+template <class Ar> void SnapshotAccess::geo(Ar &ar, Geo &g) {
+    Geo::raster_state &r = g.raster_;
+    ar.arr(r.viewport);
+    ar.raw(r.center, sizeof r.center);
+    ar.require(ar(r.center_sel) < 4, "center select");
+    ar(r.reverse), ar(r.z_adjust), ar(r.polygon_z), ar(r.master_z_clip), ar(r.cur_command);
+    ar.arr(r.command_buffer);
+    ar.require(ar(r.command_index) <= 32, "command index");
+    ar(r.poly_list_index), ar(r.min_z), ar(r.max_z);
+    ar.arr(r.texture_ram);
+    ar.arr(r.log_ram);
+    ar(r.cur_window);
+    for (auto &planes : r.clip_plane)
+        for (Geo::plane &pl : planes) vertex(ar, pl.normal), ar(pl.distance);
+
+    Geo::geo_state &s = g.geo_;
+    ar(s.mode);
+    ar.arr(s.matrix);
+    vertex(ar, s.focus);
+    vertex(ar, s.light);
+    ar(s.lod);
+    ar.arr(s.coef_table);
+    for (Geo::texture_parameter &tp : s.texture_parameters)
+        ar(tp.diffuse), ar(tp.ambient), ar(tp.specular_control), ar(tp.specular_scale);
+    ar.arr(s.polygon_ram0);
+    ar.arr(s.polygon_ram1);
+
+    // The last frame's polygons: drawn again while the 3D layer is kept (30 Hz
+    // mode), counted by polygon_count_r. Vertices past num_vertices are
+    // always zero (a fresh GeoPoly each).
+    std::vector<GeoPoly> &polys = g.polys;
+    const uint32_t n = ar.count(uint32_t(polys.size()), 33);
+    if (!ar.require(n <= kMaxPolys, "polygon count")) return;
+    if (ar.apply()) polys.assign(n, GeoPoly{});
+    GeoPoly scratch;
+    for (uint32_t i = 0; i < n && ar.ok(); ++i) {
+        GeoPoly &p = (Ar::kSaving || ar.apply()) ? polys[i] : scratch;
+        ar(p.z);
+        ar.arr(p.texheader);
+        ar(p.luma), ar(p.texlod);
+        ar.arr(p.viewport);
+        ar.arr(p.center);
+        ar(p.window), ar(p.reverse);
+        const uint8_t nv = ar(p.num_vertices);
+        if (!ar.require(nv <= 8, "polygon vertices")) return;
+        for (uint8_t k = 0; k < nv; ++k) vertex(ar, p.v[k]);
+    }
+}
+
+template <class Ar> void SnapshotAccess::video(Ar &ar, Video &v) {
+    // Pens are not a function of palette RAM alone (a colour-translation
+    // write recomputes only the first 4096 at the next update): kept as they are.
+    ar.arr(v.pens_);
+    ar(v.palette_dirty_);
+    ar(v.crtc_x_), ar(v.crtc_y_), ar(v.render_x_), ar(v.render_y_);
+    const bool kept = ar(v.render_done_);
+    ar(v.rendered_now_);
+    ar(v.coverage_), ar(v.hud_on_);
+    // The 3D layer's visible part, width() x H, as screen_update copies it:
+    // shown again while render_done_ (until the geometrizer's next frame, a
+    // frame later in 30 Hz mode), and what raster().pixels() and
+    // raster_hash() give until the next 3D frame clears it (through 2D
+    // screens too, where nothing draws over it).
+    Raster &r = v.raster_;
+    uint32_t margin = uint32_t(r.margin_), width = uint32_t(Video::W + 2 * r.margin_), rows = Video::H;
+    margin = ar(margin), width = ar(width), rows = ar(rows);
+    if (!ar.require(width == Video::W + 2 * margin && rows == Video::H, "3D layer size")) return;
+    if constexpr (Ar::kSaving) {
+        for (uint32_t y = 0; y < rows; ++y) ar.raw(r.dest_.data() + size_t(y) * size_t(r.stride_), width * 4);
+    } else if (int(margin) != r.margin_) {
+        // Another widescreen margin here: a kept layer is drawn again from
+        // the polygons at the next update instead.
+        ar.skip(size_t(width) * rows * 4);
+        if (ar.apply() && ar.ok() && kept) v.render_done_ = false;
+    } else {
+        if (ar.apply()) std::fill(r.dest_.begin(), r.dest_.end(), 0u);
+        for (uint32_t y = 0; y < rows && ar.ok(); ++y) ar.raw(r.dest_.data() + size_t(y) * size_t(r.stride_), width * 4);
+    }
+}
+
+template <class Ar> bool SnapshotAccess::present(Ar &ar, bool here) {
+    if constexpr (Ar::kSaving) return ar(here);
+    else return ar.template get<bool>();
+}
+
+template <class Ar> void SnapshotAccess::comm(Ar &ar, M2Board &b) {
+    const bool here = b.comm_board_ != nullptr;
+    // A link-play state goes to a machine with a link (set_link first), and
+    // only there: the game reads the board's registers.
+    if (!ar.require(present(ar, here) == here, "link play: the comm board's presence differs")) return;
+    if (!here) return;
+    CommBoard &c = *b.comm_board_;
+    uint16_t offset = c.frame_offset_;
+    ar.require(ar(offset) == c.frame_offset_, "comm frame offset");
+    ar(c.zfg_), ar(c.cn_), ar(c.fg_), ar(c.framesync_);
+    ar(c.linkenable_), ar(c.linkalive_), ar(c.linkid_), ar(c.linkcount_), ar(c.zfg_delay_);
+    ar(c.linktimer_);
+    ar.arr(c.buffer0_);
+    ar.vec(c.rx_);
+}
+
+// The sound board. A state without one leaves this machine's as it is; one
+// with it, loaded where there is none (a frontend with its own audio), is
+// skipped: the i960 never reads the sound board, so the game is the same.
+template <class Ar> void SnapshotAccess::sound(Ar &ar, snd::SoundBoard *s) {
+    const bool there = present(ar, s != nullptr);
+    if (!there) return;
+    if constexpr (!Ar::kSaving)
+        if (!s) return ar.skip_section_rest();
+    snd::Cpu68k &c = s->cpu_;
+    ar.arr(c.d), ar.arr(c.a);
+    ar(c.other_sp), ar(c.pc);
+    ar(c.x), ar(c.n), ar(c.z), ar(c.v), ar(c.c);
+    ar(c.sys);
+    ar(c.irq_line);
+    ar.fixed(c.ram);
+
+    snd::Sched &sc = s->sched_;
+    ar(sc.count), ar(sc.end_count), ar(sc.next_count), ar(sc.auto_irq);
+    if constexpr (Ar::kSaving) {
+        ar(uint32_t(sc.events_.size()));
+        for (const auto &[at, e] : sc.events_) {
+            ar.require(e.tag.kind == snd::SoundBoard::kRxByte || e.tag.kind == snd::SoundBoard::kYmTimer,
+                       "a sound event no snapshot knows is pending (a tool's own)");
+            ar(at), ar(e.tag.kind), ar(e.tag.arg);
+        }
+    } else {
+        const uint32_t n = ar.count(0, 20);
+        std::vector<std::pair<uint64_t, snd::Sched::Tag>> events;
+        uint64_t last = 0;
+        for (uint32_t i = 0; i < n && ar.ok(); ++i) {
+            const uint64_t at = ar.template get<uint64_t>();
+            snd::Sched::Tag tag;
+            tag.kind = ar.template get<uint32_t>();
+            tag.arg = ar.template get<uint64_t>();
+            ar.require(tag.kind == snd::SoundBoard::kRxByte || tag.kind == snd::SoundBoard::kYmTimer, "sound event");
+            ar.require(at >= last, "sound events out of order");
+            last = at;
+            events.emplace_back(at, tag);
+        }
+        if (ar.apply() && ar.ok()) {
+            sc.events_.clear();
+            for (const auto &[at, tag] : events) sc.events_.emplace_hint(sc.events_.end(), at, snd::Sched::Event{s->event(tag), tag});
+        }
+    }
+
+    ar(s->expect_mode_), ar(s->rx_enable_), ar(s->rxrdy_), ar(s->rx_hold_), ar(s->errors_);
+    ar(s->line_free_);
+    uint64_t received = s->received_;
+    received = ar(received);
+    if (ar.apply() && ar.ok()) s->received_ = size_t(received);
+    ar(s->carry_); // a double: its bits
+    ar(s->fm_done_);
+    ar.arr(s->timer_gen_);
+    ar.arr(s->timer_due_clk_);
+    ar.require(ar(s->in_timer_) == -1, "inside a YM timer");
+    ar.arr(s->pcm_slot_);
+    ar.arr(s->pcm_register_);
+    ar(s->pcm_done_);
+    if (ar.apply() && ar.ok()) {
+        s->fm_out_.clear(); // rendered before the state: not this timeline's
+        s->pcm_out_.clear();
+    }
+}
+
+template <class Ar> void SnapshotAccess::ym(Ar &ar, snd::SoundBoard *s) {
+    using namespace ymfm_access;
+    const bool there = present(ar, s != nullptr);
+    if (!there) return;
+    if constexpr (!Ar::kSaving)
+        if (!s) return ar.skip_section_rest();
+    Engine &fm = s->ym_.*member(Fm());
+    uint32_t active = fm.*member(Active()), modified = fm.*member(Modified()), prepare = fm.*member(Prepare());
+    if constexpr (Ar::kSaving) {
+        std::vector<uint8_t> blob;
+        ymfm::ymfm_saved_state st(blob, true);
+        s->ym_.save_restore(st);
+        fm.*member(Modified()) = modified; // (save_restore marks every channel modified: undone, saving changes nothing)
+        ar.vec(blob);
+        ar(active), ar(modified), ar(prepare);
+    } else {
+        // ymfm's format is fixed for the chip: the size a fresh one saves.
+        struct Quiet : ymfm::ymfm_interface {} quiet;
+        ymfm::ym3438 fresh(quiet);
+        std::vector<uint8_t> expect, blob;
+        ymfm::ymfm_saved_state probe(expect, true);
+        fresh.save_restore(probe);
+        const uint32_t n = ar.template get<uint32_t>();
+        if (!ar.require(n == expect.size(), "YM3438 state size")) return;
+        blob.resize(n);
+        const bool apply = ar.apply();
+        ar.raw(blob.data(), n); // (stored only when applying)
+        active = ar.template get<uint32_t>();
+        modified = ar.template get<uint32_t>();
+        prepare = ar.template get<uint32_t>();
+        if (!apply || !ar.ok()) return;
+        ymfm::ymfm_saved_state st(blob, false);
+        s->ym_.save_restore(st);
+        // The operators' caches, as prepare() fills them from the registers
+        // (without prepare's key-state step, which the schedule decides).
+        for (uint32_t i = 0; i < Engine::OPERATORS; ++i) {
+            auto *op = fm.debug_operator(i);
+            fm.regs().cache_operator_data(op->choffs(), op->opoffs(), op->debug_cache());
+        }
+        fm.*member(Active()) = active;
+        fm.*member(Modified()) = modified;
+        fm.*member(Prepare()) = prepare;
+    }
+}
+
+template <class Ar> void SnapshotAccess::pcm(Ar &ar, snd::SoundBoard *s, int chip) {
+    const bool there = present(ar, s != nullptr);
+    if (!there) return;
+    if constexpr (!Ar::kSaving)
+        if (!s) return ar.skip_section_rest();
+    snd::MultiPcm &m = chip ? s->pcm2_ : s->pcm1_;
+    ar.require(ar(m.bank_) <= 3, "MultiPCM bank");
+    ar(m.cur_slot_), ar(m.address_);
+    // LFO tables by name: 0 none, 1 pitch, 2 amplitude; scales by table and row.
+    auto lfo = [&](snd::MultiPcm::Lfo &l) {
+        ar(l.phase), ar(l.phase_step);
+        uint8_t table = 0, scale = 0, row = 0;
+        if constexpr (Ar::kSaving) {
+            table = l.table == nullptr ? 0 : l.table == m.pitch_table_ ? 1 : l.table == m.amplitude_table_ ? 2 : 3;
+            for (uint8_t k = 0; k < 8; ++k) {
+                if (l.scale == m.pitch_scale_tables_[k]) scale = 1, row = k;
+                if (l.scale == m.amplitude_scale_tables_[k]) scale = 2, row = k;
+            }
+            ar.require(table < 3 && (l.scale == nullptr || scale != 0), "MultiPCM LFO table");
+        }
+        table = ar(table), scale = ar(scale), row = ar(row);
+        if (!ar.require(table < 3 && scale < 3 && row < 8, "MultiPCM LFO table")) return;
+        if (ar.apply()) {
+            l.table = table == 1 ? m.pitch_table_ : table == 2 ? m.amplitude_table_ : nullptr;
+            l.scale = scale == 1 ? m.pitch_scale_tables_[row] : scale == 2 ? m.amplitude_scale_tables_[row] : nullptr;
+        }
+    };
+    for (snd::MultiPcm::Slot &sl : m.slots_) {
+        ar.arr(sl.regs);
+        ar(sl.playing);
+        snd::MultiPcm::Sample &sa = sl.sample;
+        ar(sa.start), ar(sa.loop), ar(sa.end);
+        ar(sa.attack_reg), ar(sa.decay1_reg), ar(sa.decay2_reg), ar(sa.decay_level), ar(sa.release_reg);
+        ar(sa.key_rate_scale), ar(sa.lfo_vibrato_reg), ar(sa.lfo_amplitude_reg), ar(sa.format);
+        ar(sl.offset), ar(sl.octave), ar(sl.pitch), ar(sl.step), ar(sl.reverse), ar(sl.pan), ar(sl.dsp_send);
+        ar(sl.total_level), ar(sl.dest_total_level), ar(sl.total_level_step), ar(sl.prev_sample);
+        snd::MultiPcm::Envelope &e = sl.env;
+        ar(e.volume);
+        ar.en(e.state, snd::MultiPcm::State::Release);
+        ar(e.reverb), ar(e.attack_rate), ar(e.decay1_rate), ar(e.decay2_rate), ar(e.release_rate), ar(e.decay_level);
+        ar(sl.lfo_frequency);
+        lfo(sl.pitch_lfo);
+        ar(sl.vibrato);
+        lfo(sl.amplitude_lfo);
+        ar(sl.tremolo);
+        ar(sl.effect);
+        if (!ar.ok()) return;
+    }
+}
+
+// After a load: what the screen and the renderers cache from RAM is
+// rebuilt from it at the next update.
+void SnapshotAccess::loaded(GameLoop &g) {
+    M2Board &b = *g.board_;
+    ++b.tex_generation_; // the hardware renderer uploads texture RAM again when this moves
+    Video &v = *b.video_;
+#ifdef M2_VITA_RENDER_OPT
+    v.tiles_valid_ = false;
+    v.background_dirty_ = v.foreground_dirty_ = true;
+#else
+    v.dec_valid_ = false; // every tile decoded again from tile and character RAM
+#endif
+    v.tile_memory_touched_ = v.character_memory_touched_ = true;
+    v.system24_source_dirty_ = true;
+    v.set_raster_hud_moves(); // the HUD's move follows hud_on_
+}
+
+size_t SnapshotAccess::bound(const GameLoop &g) {
+    const M2Board &b = *g.board_;
+    size_t n = kHeaderSize + 17 * kSectionHeader;
+    n += 64;                                                         // LOOP
+    n += 4 * (32 + 64 + 4 + 1) + 32 + 4 * 10 + 4;                    // CPU
+    n += 64 + kBoundCallbacks * 9;                                   // LOCK
+    n += 8;                                                          // ENH
+    n += 128 + std::max(b.uart_out_.size(), kBoundUartBytes);       // BRD
+    for (const std::vector<uint8_t> *r : {&b.ram_, &b.work_, &b.cpuctl_, &b.backup_, &b.tile_, &b.chr_, &b.palette_,
+                                          &b.xlat_, &b.tex0_, &b.tex1_, &b.luma_, &b.fb_a_, &b.fb_b_, &b.comm_})
+        n += 4 + r->size();                                          // RAM
+    n += 0x800 + 128 + 8;                                            // IO
+    const TgpBoard &t = b.tgp_;
+    n += 64 + 4 * (std::max(t.in_.size(), kBoundFifoWords) + std::max(t.out_.size(), kBoundFifoWords) + 0x1000) +
+         sizeof t.buffer_;                                           // TGPB
+    n += 256 + sizeof t.tgp_.data + sizeof t.tgp_.prog;              // TGP
+    n += sizeof(Geo::raster_state) + sizeof(Geo::geo_state) + 4 +
+         std::max(b.geo_->polys.size(), kBoundPolys) * (33 + 8 * 20); // GEO (the structs' sizes bound their fields)
+    const Video &v = *b.video_;
+    n += sizeof v.pens_ + 64 + size_t(v.width()) * Video::H * 4;     // VID
+    n += 64 + 0x1000 + (b.comm_board_ ? b.comm_board_->rx_.size() : 0) + 0x2000; // COMM
+    n += 1;
+    if (const snd::SoundBoard *s = g.sound_.get()) {
+        n += 256 + s->cpu_.ram.size() + std::max(s->sched_.events_.size(), kBoundSoundEvents) * 20 + 128; // SND
+        n += 4096;                                                   // YM (ymfm saves about 1 KB)
+        n += 2 * (16 + 28 * 128);                                    // PCM1, PCM2
+    }
+    return n + 4096;
+}
+
+// --- the interface ------------------------------------------------------------------
+
+namespace {
+void put64(uint8_t *p, uint64_t v) { std::memcpy(p, &v, 8); }
+uint64_t get64(const uint8_t *p) {
+    uint64_t v;
+    std::memcpy(&v, p, 8);
+    return v;
+}
+uint32_t get32(const uint8_t *p) {
+    uint32_t v;
+    std::memcpy(&v, p, 4);
+    return v;
+}
+void romset(uint8_t *out) {
+    std::memset(out, 0, 16);
+    const std::string s = M2_ROMSET;
+    std::memcpy(out, s.data(), std::min<size_t>(s.size(), 16));
+}
+uint64_t fingerprint(const std::vector<uint8_t> &image) { return hash64(image.data(), image.size()); }
+} // namespace
+
+std::vector<uint8_t> save_state(GameLoop &game) {
+    if (SnapshotAccess::sound_pending(game)) throw Fatal("snapshot: a deferred sound frame is pending: complete it first");
+    std::vector<uint8_t> out;
+    out.reserve(state_size_bound(game));
+    out.resize(kHeaderSize);
+    Writer w(out);
+    SnapshotAccess::state(w, game);
+    uint8_t *h = out.data();
+    std::memcpy(h, kMagic, 8);
+    std::memcpy(h + 8, &kVersion, 4);
+    std::memcpy(h + 12, &kHeaderSize, 4);
+    put64(h + 16, out.size() - kHeaderSize);
+    put64(h + 24, hash64(out.data() + kHeaderSize, out.size() - kHeaderSize));
+    romset(h + 32);
+    put64(h + 48, fingerprint(SnapshotAccess::images(game).program));
+    put64(h + 56, fingerprint(SnapshotAccess::images(game).sound_program));
+    return out;
+}
+
+bool load_state(GameLoop &game, const uint8_t *data, size_t size) {
+    if (SnapshotAccess::sound_pending(game)) throw Fatal("snapshot: a deferred sound frame is pending: complete it first");
+    if (!data || size < kHeaderSize) return false;
+    if (std::memcmp(data, kMagic, 8) != 0 || get32(data + 8) != kVersion || get32(data + 12) != kHeaderSize) return false;
+    const uint64_t body = get64(data + 16);
+    if (body > size - kHeaderSize) return false;
+    for (size_t i = kHeaderSize + size_t(body); i < size; ++i)
+        if (data[i]) return false; // only zero padding after the state
+    uint8_t set[16];
+    romset(set);
+    if (std::memcmp(data + 32, set, 16) != 0) return false;
+    if (get64(data + 48) != fingerprint(SnapshotAccess::images(game).program) ||
+        get64(data + 56) != fingerprint(SnapshotAccess::images(game).sound_program))
+        return false;
+    const uint8_t *const p = data + kHeaderSize;
+    if (hash64(p, size_t(body)) != get64(data + 24)) return false;
+
+    Reader check(p, size_t(body), false);
+    SnapshotAccess::state(check, game);
+    if (!check.ok() || !check.at_end()) return false;
+    Reader apply(p, size_t(body), true);
+    SnapshotAccess::state(apply, game);
+    if (!apply.ok() || !apply.at_end()) throw Fatal("snapshot: a state that checked out failed to load");
+    SnapshotAccess::loaded(game);
+    return true;
+}
+
+size_t state_size_bound(const GameLoop &game) { return SnapshotAccess::bound(game); }
+
+uint8_t *main_ram(M2Board &board, size_t *size) { return SnapshotAccess::work_ram(board, size); }
+
+} // namespace rt
diff --git a/src/runtime/snapshot.h b/src/runtime/snapshot.h
new file mode 100644
index 0000000..1d08ff1
--- /dev/null
+++ b/src/runtime/snapshot.h
@@ -0,0 +1,105 @@
+// Snapshots of the whole machine (save states): everything the game, its
+// sound and its link depend on, so a second GameLoop of the same ROM set,
+// loaded with one, continues exactly as the first would have: the same
+// instructions at the same counts, the same RAM, the same screen and sound.
+// Made for lockstep play, where a machine joining a game (or one that has
+// drifted) is handed the state of one already in it.
+//
+// Take one between frames: after run_frame (or once a deferred sound frame
+// has completed), never from inside the game's code or a detached sound
+// packet. Load one onto a GameLoop of the same ROM set and build, normally a
+// freshly constructed one (any GameLoop works: everything in the state is
+// overwritten and what the screen caches is rebuilt). A link-play state
+// needs board().set_link(...) on the target first: the comm board's presence
+// must match. Bytes the link transport holds (sent, not yet read) are the
+// host's, not in the state.
+//
+// Not in the state, on purpose: the ROM images (only a fingerprint of the
+// program ROMs, so another set's state is refused), tables made from them or
+// from constants, the viewer's own settings (widescreen, frame skip, external
+// 3D, HUD at the edges, stretched backdrop, the launcher's volumes), output
+// waiting for the host (the composed screen, rendered audio not yet taken,
+// drive board commands, the EEPROM-dirty flag), the frame profiler, debug
+// records (Geo::pushed) and the link transport. The draw-distance
+// enhancement (a global) is in it: it changes the game's own RAM, so a state
+// carries it and a load sets it.
+//
+// Format (all little-endian; floats and doubles as their bits):
+//
+//   header, 64 bytes:
+//     0  char[8]  magic "M2SNAPST"
+//     8  u32      format version (kVersion)
+//    12  u32      header size (64)
+//    16  u64      body size: bytes after the header
+//    24  u64      check: a 64-bit hash of the body (snapshot.cpp, hash64)
+//    32  char[16] ROM set (M2_ROMSET), zero-padded
+//    48  u64      fingerprint (hash64) of the i960 program image
+//    56  u64      fingerprint of the sound program image
+//   body: sections, in a fixed order, each
+//     u32 tag (four characters), u32 section version, u64 size, then size
+//     bytes; the last is "END " with size 0.
+//
+// A load checks the header, the hash, then every section's tag, version and
+// size against what this build expects (and each variable-length part
+// against its section's size) before it changes anything: a truncated,
+// corrupted or foreign state is refused with false and the GameLoop is left
+// as it was. Bytes after the end of the state must be zero (a caller may
+// pass a zero-padded buffer of state_size_bound bytes).
+//
+// Sections (snapshot.cpp has the field order of each):
+//   "LOOP" GameLoop: frame count, vblank phase and its counts, latched inputs
+//   "CPU " i960: registers, register cache and its frames, AC, PC, IP, SAT,
+//          PRCB, ICR, FP registers, interrupt state (no TC: not modelled)
+//   "LOCK" Lockstep: instruction count, next event, pending callbacks (by
+//          Lockstep::Callback tag: the frame probe, the UART's shift)
+//   "ENH " the draw-distance enhancement and its budget flag
+//   "BRD " M2Board registers: interrupts, timers, video control, render
+//          mode, comm registers, frame number, the sound UART and the bytes
+//          for the sound board not yet taken
+//   "RAM " every RAM of the board, each with its size: main, work, CPU
+//          control, backup, tile, character, palette, colour translation,
+//          texture 0 and 1, luma, frame buffers A and B, comm shared RAM
+//   "IO  " the I/O board: dual-port RAM, EEPROM, latched inputs
+//   "TGPB" TGP board: FIFOs, program upload, control registers, buffer RAM
+//   "TGP " the TGP: registers, data RAM, program RAM, instruction count
+//   "GEO " the geometrizer's state and its last frame's polygons
+//   "VID " palette pens, CRTC and render offsets, whether the 3D layer is
+//          kept for the next frame, the 3D layer (its visible part)
+//   "COMM" present flag, then the comm board's registers and buffers
+//   "SND " present flag, then the 68000, its RAM and schedule (by
+//          Sched::Tag: bytes on the serial line, YM timers), the UART, YM
+//          timer generations, rendered-sample counts
+//   "YM  " present flag, then the YM3438 (ymfm's save_restore, plus the
+//          three engine counters it leaves out)
+//   "PCM1", "PCM2" present flag, then the MultiPCMs
+//   "END "
+#pragma once
+
+#include "runtime/game_loop.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace rt {
+
+// Everything needed to continue identically. Throws rt::Fatal while a
+// deferred sound frame is pending, or while a callback or sound event no
+// snapshot knows is pending (a tool's own).
+std::vector<uint8_t> save_state(GameLoop &game);
+// Onto a GameLoop of the same ROM set (normally freshly constructed). False,
+// with nothing changed, if the data is not a whole, intact state of this
+// build, this ROM set and this machine's configuration (comm board). A
+// machine without a sound board takes a state with one (the sound sections
+// are skipped: the i960 never reads the sound board) and the reverse (its
+// sound board is left as it was).
+bool load_state(GameLoop &game, const uint8_t *data, size_t size);
+// At least save_state(game).size() for any state this machine reaches while
+// its queues stay within generous limits (snapshot.cpp, kBound*): for callers
+// that pre-allocate. Compare save_state's size with it anyway.
+size_t state_size_bound(const GameLoop &game);
+// The i960's work RAM (1 MB at 0x00500000, where the game keeps its state):
+// for the host's desync hash.
+uint8_t *main_ram(M2Board &board, size_t *size);
+
+} // namespace rt
