@@ -189,6 +189,28 @@
 // Store f32 value to rd (assumes value is already on stack)
 static inline void emitStoreRdF32(WasmModuleBuilder& b, const shil_param& rd) {
 	b.op_f32_store(rd.reg_offset());
+}
+
+// Arcade bar (flycast/patches/0005): stores an arithmetic result ([ctx, f32] on the stack) with
+// any NaN made the one quiet NaN the SH4's FPU itself produces, 0x7FBFFFFF. WebAssembly leaves a
+// NaN's sign and payload to the host (x86 makes 0xFFC00000 where ARM makes 0x7FC00000), so two
+// players' machines, one on each, would otherwise differ from the first 0/0 whose bits the game
+// keeps. Uses LOCAL_TMP. fabs/fneg (bit operations) and conversions don't need it.
+static inline void emitStoreF32Canonical(WasmModuleBuilder& b, u32 offset) {
+	b.op_i32_reinterpret_f32();
+	b.op_local_set(LOCAL_TMP);
+	b.op_i32_const((s32)0x7FBFFFFF);
+	b.op_local_get(LOCAL_TMP);
+	b.op_local_get(LOCAL_TMP);
+	b.op_i32_const(0x7FFFFFFF);
+	b.op_i32_and();
+	b.op_i32_const(0x7F800000);
+	b.op_i32_gt_u();            // exponent all ones and a nonzero fraction: a NaN
+	b.op_select();
+	b.op_i32_store(offset);
+}
+static inline void emitStoreRdF32Canonical(WasmModuleBuilder& b, const shil_param& rd) {
+	emitStoreF32Canonical(b, rd.reg_offset());
 }
 
