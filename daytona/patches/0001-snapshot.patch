diff --git a/tests/test_snapshot.cpp b/tests/test_snapshot.cpp
new file mode 100644
index 0000000..e48671b
--- /dev/null
+++ b/tests/test_snapshot.cpp
@@ -0,0 +1,845 @@
+// Snapshots (src/runtime/snapshot.cpp) without the ROM: a whole GameLoop on
+// synthetic images, running hand-written stand-ins for the three recompiled
+// programs (the i960 game, the TGP, the sound 68000). Each stand-in calls the
+// runtime as generated code does (boundary before an instruction, the count
+// after it, memory through the bus), and between them they reach every part a
+// snapshot carries: interrupts (nested, pending), the register cache spilled
+// to memory, the TGP's FIFOs and upload, a display list the geometrizer turns
+// into polygons and the rasterizer draws (in 30 Hz mode too, where the 3D
+// layer is kept a frame), tilemaps and palette, the I/O board and EEPROM, the
+// sound UART (more bytes some frames than the line carries in a frame, so
+// some are still on it at the save), the 68000 with its interrupt, YM timers
+// and voices, both MultiPCMs (LFOs on), and a link-play comm board on an
+// in-memory transport.
+//
+// Checks: a state loaded into a fresh machine saves to the same bytes; it
+// then runs on exactly as the machine it came from (screen, 3D layer, work
+// RAM, audio samples, instruction counts, frame by frame, and the whole state
+// at the end); loading into a machine that has been running works the same;
+// taking snapshots does not change the machine; the public accessors agree
+// after a load; a UART shift pending across the save; truncated, corrupted,
+// foreign or inconsistent states are refused and leave the machine
+// untouched; link presence must match, and a frame half received goes along;
+// a machine without a sound board takes a state with one (and the reverse),
+// and its untaken sound bytes go along. Prints the state's size and the time
+// to save and load it.
+
+#include "runtime/snapshot.h"
+
+#include <algorithm>
+#include <bit>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <memory>
+#include <string>
+#include <vector>
+
+// --- stand-ins for the generated code -------------------------------------------------
+
+namespace {
+
+constexpr uint32_t crc32_words(const uint32_t *w, size_t n) { // as TgpBoard checks the upload
+    uint32_t c = 0xffffffffu;
+    for (size_t i = 0; i < n; i++)
+        for (int b = 0; b < 4; b++) {
+            c ^= (w[i] >> (8 * b)) & 0xff;
+            for (int k = 0; k < 8; k++) c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1)));
+        }
+    return ~c;
+}
+constexpr uint32_t kTgpProgram[4] = {0x11111111, 0x22222222, 0x33333333, 0x44444444};
+
+// i960 memory map of the stand-in game
+constexpr uint32_t kPrcb = 0x1000, kEntry = 0x2000, kIntTab = 0x00200000, kIntStack = 0x00580000;
+constexpr uint32_t kVblankHandler = 0x3000, kUartHandler = 0x3400;
+constexpr uint32_t kFrameCounter = 0x00500000, kSendLeft = 0x00500010, kLoops = 0x00500014, kInputs = 0x00500020;
+constexpr uint32_t kVecVblank = 0x1a, kVecUart = 0x32; // priorities 3 and 6
+constexpr uint32_t kListWord = 0x100;                  // display list in buffer RAM (word index)
+
+uint32_t rd32(rt::Cpu &c, uint32_t a) { return c.bus->read_dword(a); }
+void wr32(rt::Cpu &c, uint32_t a, uint32_t v) { c.bus->write_dword(a, v); }
+uint32_t f2u(float f) { return std::bit_cast<uint32_t>(f); }
+
+// The display list: a window, then a strip of quads whose position follows
+// the frame and the wheel.
+void display_list(rt::Cpu &c, uint32_t frame, uint32_t steer) {
+    uint32_t a = 0x00900000 + kListWord * 4;
+    auto put = [&](uint32_t v) { wr32(c, a, v), a += 4; };
+    put(0x03u << 23); // window
+    put(0);
+    put((495u << 16) | 383u);
+    for (int k = 0; k < 4; ++k) put(((248u + (frame & 7)) << 16) | 192u);
+    put(0x02u << 23); // direct data
+    put(0x10 + (frame & 0x30));
+    put(0x20);
+    const float shift = float(int(steer) - 0x80) * 8.0f + float(frame % 40) * 10.0f;
+    put(f2u(-1500 + shift)), put(f2u(-1500)), put(f2u(10));
+    put(f2u(-1500 + shift)), put(f2u(1500)), put(f2u(10));
+    for (int q = 0; q < 4; ++q) {
+        put(1u | (1u << 8) | (1u << 10) | (1u << 17)); // quad, linked, min z, double sided
+        put(0x00400000 + (uint32_t(q) << 15));
+        put(f2u(1.0f));
+        const float x = -1500 + shift + 800.0f * float(q + 1);
+        put(f2u(x)), put(f2u(-1500 + float(q) * 100)), put(f2u(10 + float(q)));
+        put(f2u(x)), put(f2u(1500)), put(f2u(10 + float(q)));
+    }
+    put(0);
+    put(0x0fu << 23); // end
+}
+
+void i960_step(rt::Cpu &c, uint32_t ip) {
+    uint32_t *const R = c.m_r;
+    switch (ip) {
+    // boot: interrupt table, enables, priority, the TGP's program, the screen
+    case kEntry:
+        c.m_ICR = (kVecUart << 24) | (0x2au << 16) | (0x22u << 8) | kVecVblank;
+        wr32(c, kIntTab + 36 + (kVecVblank - 8) * 4, kVblankHandler);
+        wr32(c, kIntTab + 36 + (kVecUart - 8) * 4, kUartHandler);
+        c.m_IP = 0x2004;
+        return;
+    case 0x2004:
+        wr32(c, 0x00e80004, 0x401); // vblank and sound UART interrupts
+        c.m_IP = 0x2008;
+        return;
+    case 0x2008: { // modpc: priority 0, executing
+        const uint32_t was = c.m_PC;
+        c.m_PC = 0x00000002;
+        c.m_IP = 0x200c;
+        if ((was >> 16 & 0x1f) > (c.m_PC >> 16 & 0x1f)) c.check_pending_irqs();
+        return;
+    }
+    case 0x200c:
+        wr32(c, 0x00980000, 0x80000000); // TGP upload
+        for (uint32_t w : kTgpProgram) wr32(c, 0x00884000, w);
+        wr32(c, 0x00980000, 0); // boot it
+        c.m_IP = 0x2010;
+        return;
+    case 0x2010:
+        for (uint32_t i = 0; i < 64; ++i) c.bus->write_word(0x01080000 + i * 2, uint16_t(0x1234 * (i + 1))); // characters
+        for (uint32_t i = 0; i < 128; ++i) c.bus->write_word(0x01000000 + i * 2, uint16_t((i & 3) | (i << 7)));  // layer 0 tiles
+        c.bus->write_word(0x01000000 + 0x5005 * 2, 0x8000); // layers 1-3 off (vscr bit 15)
+        c.bus->write_word(0x01000000 + 0x5006 * 2, 0x8000);
+        c.bus->write_word(0x01000000 + 0x5007 * 2, 0x8000);
+        wr32(c, 0x0181c000, 0xff); // z clip off
+        c.m_IP = 0x2020;
+        return;
+
+    // main loop
+    case 0x2020: {
+        R[16] = c.bus->read_byte(kFrameCounter);
+        const uint32_t frame = R[16];
+        const uint32_t n = 2 + frame % 3;
+        for (uint32_t k = 0; k < n; ++k) wr32(c, 0x00880000 + (k << 2), frame * 16 + k); // TGP function port
+        for (uint32_t k = 0; k + 1 < n; ++k) wr32(c, 0x00500100 + k * 4, rd32(c, 0x00884000)); // results
+        R[17] = rd32(c, 0x00980004);                     // FIFO status
+        wr32(c, 0x00500140, rd32(c, 0x00900000 + 0x40)); // buffer RAM the TGP wrote
+        display_list(c, frame, rd32(c, kInputs) & 0xff);
+        wr32(c, 0x00803008, kListWord * 4);   // geometrizer read start
+        wr32(c, 0x00801008, 0x10000);         // write start, and three words pushed there
+        for (uint32_t k = 0; k < 3; ++k) wr32(c, 0x00800000 + (k << 4), 0x80000000u | (frame + k));
+        wr32(c, 0x0098000c, (frame / 16) & 1); // 30 Hz mode on and off
+        wr32(c, 0x00884000, 0xa0000000 | frame); // left in the TGP's input FIFO at the frame's end
+        wr32(c, 0x00884000, 0xb0000000 | frame);
+        c.m_IP = 0x2024;
+        return;
+    }
+    case 0x2024: // call six deep: the register cache spills
+        c.m_IP = 0x2028;
+        c.do_call(0x2100, 0, R[1]);
+        return;
+    case 0x2028: {
+        const uint32_t frame = c.bus->read_byte(kFrameCounter);
+        wr32(c, kLoops, rd32(c, kLoops) + 1);
+        for (int k = 0; k < 4; ++k) R[21] += rd32(c, 0x01a04000); // comm board status (link play takes frames in here)
+        // I/O board: latch the inputs, keep them; EEPROM store and load
+        c.bus->write_byte(0x01c00040, 1);
+        wr32(c, kInputs, rd32(c, 0x01c00000) ^ rd32(c, 0x01c00008) << 8 ^ rd32(c, 0x01c00010) << 16);
+        if (frame % 7 == 3) {
+            c.bus->write_byte(0x01c00000 + (0x100 / 2) * 4, uint8_t(frame));
+            c.bus->write_byte(0x01c00040, 2);
+        }
+        if (frame % 11 == 5) c.bus->write_byte(0x01c00040, 3);
+        c.bus->write_byte(0x01c00000 + (0x11 / 2) * 4 + 2, uint8_t(0x10 + frame)); // drive board
+        // texture RAM, luma, backup, frame buffer, CPU control
+        c.bus->write_word(0x12000000 + (frame % 512) * 4, uint16_t(frame * 977));
+        c.bus->write_word(0x12400000 + (frame % 512) * 4 + 2, uint16_t(frame * 31));
+        wr32(c, 0x12800000 + (frame % 256) * 4, frame * 0x01010101u);
+        c.bus->write_byte(0x01d00000 + frame % 0x4000, uint8_t(frame));
+        wr32(c, 0x11600000 + (frame % 64) * 4, frame);
+        wr32(c, 0x00e00000 + (frame % 64) * 4, ~frame);
+        wr32(c, 0x01a00100 + (frame % 64) * 4, frame * 3); // comm shared RAM (past the board's registers)
+        wr32(c, 0x00500150, rd32(c, 0x10400000)); // polygon count
+        c.m_IP = 0x2020;
+        return;
+    }
+    case 0x12b0: // the game's wait for vblank (GameLoop's idle range)
+        R[20] = c.bus->read_byte(kFrameCounter);
+        c.m_IP = 0x12b4;
+        return;
+    case 0x12b4:
+        c.m_IP = R[20] == R[16] ? 0x12b0 : 0x12b8;
+        return;
+    case 0x12b8:
+        c.m_IP = 0x2154;
+        return;
+
+    // vblank: count the frame, write the screen's memories, send sound bytes
+    case kVblankHandler:
+        wr32(c, 0x00e80000, ~1u);
+        c.bus->write_byte(kFrameCounter, uint8_t(c.bus->read_byte(kFrameCounter) + 1));
+        c.m_IP = kVblankHandler + 4;
+        return;
+    case kVblankHandler + 4: {
+        const uint32_t frame = c.bus->read_byte(kFrameCounter);
+        for (uint32_t i = 0; i < 4; ++i) c.bus->write_word(0x01800000 + ((frame * 4 + i) % 0x2000) * 2, uint16_t(frame * 1103 + i));
+        c.bus->write_word(0x01810000 + (0x80 / 2 + (frame % 3) * 0x100) * 2, uint16_t(frame * 5)); // colour translation
+        c.bus->write_word(0x01000000 + (frame % 64) * 2, uint16_t(frame * 129));                   // a tile
+        c.bus->write_word(0x01080000 + (frame % 32) * 2, uint16_t(frame * 0x1111));                // a character
+        c.bus->write_word(0x01040000, uint16_t(frame & 3));        // CRTC
+        c.bus->write_word(0x01060000, uint16_t((frame >> 2) & 3));
+        wr32(c, 0x10000000, (frame & 1) << 2);                     // render mode
+        c.m_IP = kVblankHandler + 8;
+        return;
+    }
+    case kVblankHandler + 8: // every 5th frame more than the sound board's line carries in a frame
+        wr32(c, kSendLeft, c.bus->read_byte(kFrameCounter) % 5 == 0 ? 70 : 5);
+        c.bus->write_byte(0x01c80000, uint8_t(c.bus->read_byte(kFrameCounter) * 3));
+        c.m_IP = kVblankHandler + 12;
+        return;
+    case kVblankHandler + 12:
+        c.do_ret();
+        return;
+
+    // sound UART ready: the next byte
+    case kUartHandler:
+        wr32(c, 0x00e80000, ~0x400u);
+        c.m_IP = kUartHandler + 4;
+        return;
+    case kUartHandler + 4: {
+        const uint32_t left = rd32(c, kSendLeft);
+        if (left) {
+            wr32(c, kSendLeft, left - 1);
+            c.bus->write_byte(0x01c80000, uint8_t(c.bus->read_byte(kFrameCounter) * 7 + left * 13));
+        }
+        c.m_IP = kUartHandler + 8;
+        return;
+    }
+    case kUartHandler + 8:
+        c.do_ret();
+        return;
+    default: break;
+    }
+    if (ip >= 0x2100 && ip < 0x2160) { // six functions: work, call the next (the last waits for vblank); return
+        const uint32_t k = (ip - 0x2100) >> 4;
+        if ((ip & 0xf) == 0) {
+            R[3] = R[3] * 31 + k + R[16];
+            R[4 + k] = R[3] ^ 0x5a5a5a5au;
+            R[19] += R[3];
+            if (k == 5) {
+                c.m_IP = 0x12b0;
+            } else {
+                c.m_IP = ip + 4;
+                c.do_call(ip + 0x10, 0, R[1]);
+            }
+            return;
+        }
+        if ((ip & 0xf) == 4) {
+            c.do_ret();
+            return;
+        }
+    }
+    char b[64];
+    std::snprintf(b, sizeof b, "stand-in i960: no instruction at %08x", ip);
+    throw rt::Fatal(b);
+}
+
+// The 68000 stand-in: UART set up, YM timer A running; its interrupt takes
+// each byte and plays it on the YM and a MultiPCM.
+void snd_step(snd::Cpu68k &c, snd::Sched &s, uint32_t pc) {
+    auto ym = [&](uint8_t reg, uint8_t v, bool hi = false) {
+        c.w8(hi ? 0xd00005 : 0xd00001, reg);
+        c.w8(hi ? 0xd00007 : 0xd00003, v);
+    };
+    switch (pc) {
+    case 0x400:
+        c.w8(0xc20003, 0x4e); // UART mode, then command: receive on
+        c.w8(0xc20003, 0x15);
+        ym(0x24, 0xf0), ym(0x25, 0x01), ym(0x27, 0x15); // timer A
+        ym(0x22, 0x0b); // LFO on
+        c.set_sr(0x2000);
+        s.poke();
+        c.pc = 0x410;
+        return;
+    case 0x410: {
+        const uint8_t status = c.r8(0xd00001);
+        c.w8(0xf00100, status);
+        if (status & 1) {
+            ym(0x27, 0x15);
+            const uint8_t ticks = uint8_t(c.r8(0xf00101) + 1);
+            c.w8(0xf00101, ticks);
+            if ((ticks & 7) == 0) ym(0x28, uint8_t(ticks >> 3 & 3)); // a key off now and then
+        }
+        c.pc = 0x410;
+        return;
+    }
+    case 0x500: { // IRQ 2: a byte from the i960
+        const uint8_t b = c.r8(0xc20001);
+        const uint8_t at = c.r8(0xf00102);
+        c.w8(0xf00200 + at, b);
+        c.w8(0xf00102, uint8_t(at + 1));
+        const uint8_t ch = b & 3;
+        ym(uint8_t(0xa4 + ch), uint8_t(0x20 | ((b >> 2) & 7)), b & 0x80);
+        ym(uint8_t(0xa0 + ch), uint8_t(b * 7), b & 0x80);
+        ym(uint8_t(0xb0 + ch), uint8_t(b & 7), b & 0x80);
+        ym(uint8_t(0xb4 + ch), 0xc0 | (b & 0x37), b & 0x80);
+        for (uint8_t op = 0; op < 16; op += 4) {
+            ym(uint8_t(0x30 + op + ch), uint8_t(b + op), b & 0x80);
+            ym(uint8_t(0x40 + op + ch), uint8_t((b + op) & 0x3f), b & 0x80);
+            ym(uint8_t(0x50 + op + ch), 0x1f, b & 0x80);
+            ym(uint8_t(0x60 + op + ch), 0x80 | (b & 0x1f), b & 0x80);
+            ym(uint8_t(0x80 + op + ch), 0x0f, b & 0x80);
+        }
+        ym(0x28, uint8_t(0xf0 | ch | (b & 0x80 ? 4 : 0)));
+        // a MultiPCM voice: the driver's voice record first (the key-on asks whose voice it is)
+        const unsigned chip = (b >> 6) & 1;
+        const uint32_t base = chip ? 0xc60001 : 0xc40001;
+        const uint8_t slot = b & 0x1f;
+        const uint32_t voice = 0xf01500 + (b % 28) * 10;
+        c.w8(voice, uint8_t(1 | chip << 3)), c.w8(voice + 1, slot), c.w8(voice + 3, b), c.w8(voice + 6, 0);
+        c.w8(base + 2, slot);
+        auto reg = [&](uint8_t r, uint8_t v) { c.w8(base + 4, r), c.w8(base, v); };
+        reg(1, b), reg(2, uint8_t(b << 2)), reg(3, 0x40 | (b & 0xf)), reg(0, 0x40 | (b & 0xf));
+        reg(6, uint8_t(0x08 | (b & 0x3f) | 1)), reg(10, uint8_t(1 + (b & 6))), reg(5, uint8_t(b & 0xfe));
+        reg(4, (b & 0x20) ? 0x00 : 0x80);
+        c.w16(chip ? 0xc70000 : 0xc50000, b & 3);
+        c.pc = 0x504;
+        return;
+    }
+    case 0x504: { // rte
+        const uint16_t sr = c.pop16();
+        c.pc = c.pop32();
+        c.set_sr(sr);
+        s.poke();
+        return;
+    }
+    default: break;
+    }
+    char b[64];
+    std::snprintf(b, sizeof b, "stand-in 68000: no instruction at %06x", pc);
+    throw rt::Fatal(b);
+}
