+         else if (type == IPT_JOYSTICK_LEFT)  { id = RETRO_DEVICE_ID_JOYPAD_LEFT;  order = 2; label = "Left"; }
+         else if (type == IPT_JOYSTICK_RIGHT) { id = RETRO_DEVICE_ID_JOYPAD_RIGHT; order = 3; label = "Right"; }
