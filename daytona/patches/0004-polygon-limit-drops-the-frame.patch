--- a/src/runtime/geo.cpp
+++ b/src/runtime/geo.cpp
@@ -6,7 +6,8 @@
 // (BSD-3-Clause; notice above kept as the licence requires). The code below
 // is MAME's with these changes only: raw pointers are bounds-checked cursors
 // (GeoPtr, GeoPtr16); kept polygons go to a flat list (Geo::polys) instead of
-// MAME's per-z buckets; logerror is dropped and fatalerror throws. See
+// MAME's per-z buckets; logerror is dropped and fatalerror throws, except
+// at the polygon list's limit, where parse drops the frame's 3D. See
 // src/runtime/geo.h and THIRD_PARTY.md.
 
 #include "runtime/geo.h"
@@ -24,6 +25,9 @@ inline float u2f(uint32_t v) { return std::bit_cast<float>(v); }
 inline uint32_t f2u(float f) { return std::bit_cast<uint32_t>(f); }
 using u8 = uint8_t;
 using u64 = uint64_t;
+// A frame's display list made more polygons than the list holds (MAME's MAX_POLYGONS): thrown
+// where the next one would go, caught by Geo::parse, which drops that frame's 3D.
+struct PolygonListFull {};
 } // namespace
 
 #define pz      p[0]
@@ -509,8 +513,8 @@ void Geo::model2_3d_process_polygon(raster_state *raster, uint32_t attr)
 
 			/* go through the clipped vertex list, adding polygons */
 			raster->poly_list_index++;
-			if (raster->poly_list_index >= 32768) // MAME MAX_POLYGONS
-				throw GeoFatal("SEGA 3D: Max polygon limit exceeded");
+			if (raster->poly_list_index >= 32768) // MAME MAX_POLYGONS (MAME: a fatal error)
+				throw PolygonListFull{};
 			polys.emplace_back();
 			GeoPoly *poly = &polys.back();
 			poly->reverse = raster->reverse;
@@ -2230,6 +2234,7 @@ void Geo::parse(uint32_t read_start)
 	// reset raster frame variables
 	render_frame_start();
 
+	try {
 	while (end_code == false && input.i < 0x20000/4 && op_count++ < 0x8000)
 	{
 		/* read in the opcode */
@@ -2251,6 +2256,20 @@ void Geo::parse(uint32_t read_start)
 		/* process it */
 		input = geo_process_command(&geo_, opcode, input, &end_code);
 	}
+	} catch (const PolygonListFull &) {
+		// A list that does not end before the limit. Seen on a linked cabinet coming back to
+		// its attract mode at one phase of its frames: the list read is the buffer the game
+		// has not finished (the next frame parses the same buffer, whole). MAME stops there
+		// with a fatal error; the arcade shows nothing of it. This frame's 3D is dropped, as
+		// if its list had been empty, and the rasterizer's command decoder is left idle, as
+		// after a list that ended; the game, its RAM and the TGP are untouched, and the next
+		// frame's list is parsed as ever. What the list did before the limit stays done (the
+		// geometrizer's own registers and RAMs), the same on every machine.
+		render_frame_start();
+		raster_.cur_command = 0;
+		raster_.command_index = 0;
+		++dropped_frames_;
+	}
 }
 
