+uint64_t fnv(const void *p, size_t n, uint64_t h = 0xcbf29ce484222325ull) {
+    const auto *b = static_cast<const uint8_t *>(p);
+    for (size_t i = 0; i < n; ++i) h = (h ^ b[i]) * 0x100000001b3ull;
+    return h;
+}
+
+void be32(std::vector<uint8_t> &v, size_t at, uint32_t x) {
+    v[at] = uint8_t(x >> 24), v[at + 1] = uint8_t(x >> 16), v[at + 2] = uint8_t(x >> 8), v[at + 3] = uint8_t(x);
+}
+void le32(std::vector<uint8_t> &v, size_t at, uint32_t x) { std::memcpy(&v[at], &x, 4); }
+
+// The real images' sizes, where the board copies or maps them whole.
+rt::M2Board::Images images(uint8_t variant = 0) {
+    rt::M2Board::Images img;
+    img.program.assign(0x200000, 0);
+    le32(img.program, 4, kPrcb);
+    le32(img.program, 12, kEntry);
+    le32(img.program, kPrcb + 20, kIntTab);
+    le32(img.program, kPrcb + 24, kIntStack);
+    img.program[0x100000] = variant;
+    img.main_data.assign(0x2000000, 0);
+    img.copro_tables.assign(0x40000, 0);
+    for (size_t i = 0; i < img.copro_tables.size(); ++i) img.copro_tables[i] = uint8_t(i * 7);
+    img.copro_data.assign(0x800000, 0);
+    img.polygons.assign(0x10000, 0);
+    img.textures.assign(0x10000, 0);
+    for (size_t i = 0; i < img.textures.size(); ++i) img.textures[i] = uint8_t(i * 13 + 5);
+    img.sound_program.assign(0x40000, 0);
+    be32(img.sound_program, 0, 0x00f0fff0); // SSP
+    be32(img.sound_program, 4, 0x400);      // PC
+    be32(img.sound_program, (24 + 2) * 4, 0x500);
+    img.pcm1.assign(0x400000, 0);
+    img.pcm2.assign(0x400000, 0);
+    for (size_t i = 0; i < img.pcm1.size(); ++i) img.pcm1[i] = uint8_t(i * 2654435761u >> 13), img.pcm2[i] = uint8_t(i * 40503u >> 7);
+    return img;
+}
