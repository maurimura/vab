// Games cabinets can run (a cabinet's `game` in maps/bar.ron is a `rom` from this list).
// `rom` is the ROM set in R2 (/roms/<rom>.zip, plus the optional <rom>.state), `core` the FBNeo
// core that runs it (emulator/build.sh), "supermodel" for a Sega Model 3 game (supermodel/),
// "daytona" for Daytona USA (Sega Model 2, daytona/), "mame" for one MAME runs (mame/) or "flycast"
// for a Sega NAOMI game (flycast/), `bios` a BIOS set loaded next to it, and `files` more files the
// core needs, as paths under /roms/ in R2 that it finds at the same path, folders and all (a NAOMI
// GD-ROM game's disc: "vtennisg/gds-0011.chd"). `players` is how many play at once (2 if not said,
// up to 4, or 8 in arcade mode; 1 and the next to press E watches); `turns` games take turns on
// player 1's controls; `lockstep` games play online without rollback (a Sega core's save state is
// too big to take every frame); `gun` games are played with a lightgun: the mouse or a finger aims,
// with a crosshair on the screen; `linked` games are a twin cabinet, two boards joined by the
// game's own link, one per player and browser (Time Crisis II's co-op; both games start over
// when the second player sits). `arcade` games are linked cabinets, as in an arcade: every
// player's browser runs only their own cabinet, from a state for their seat
// (/roms/<rom>.seat<n>.state, n from 0), and the cabinets talk through their link boards, so the
// game's own rules say who races whom (Daytona USA: up to 8, joining at the circuit select).
// `options` are settings for the core, made before the game loads (the `_<core>_set` its module
// exports; an arcade game's also get `seat`, from the player's seat); with a `view` among them
// one machine has a screen per seat, and each player sees their own. `cabinets` names the
// cabinet skins drawn for the game (tiles/objects/cabinet_<skin>_*): the editor gives a cabinet
// in one of them the game. A game without a skin yet stands in a plain cabinet, its game picked
// in the editor. A `wheel` game is driven with a steering wheel the arrows turn: `lock` seconds
// from the middle to full lock with an arrow held, along a `curve` (1 even, 2 a tap barely turns
// it), and `back` seconds from full lock to the middle once let go; `span` is where on the core's
// analog stick (0 to 32767) its wheel turns, all of it unless said (Out Run's FBNeo core has dead
// zones). `/wheel` in the chat tries other numbers while driving and prints the line for here.
[
    (rom: "mk2", core: "midway", title: "Mortal Kombat II", cabinets: ["mk2_v2"]),
    (rom: "umk3", core: "midway", title: "Ultimate Mortal Kombat 3", cabinets: ["umk3"]),
    (rom: "kof98", core: "neogeo", title: "The King of Fighters '98", bios: Some("neogeo"), cabinets: ["kof98"]),
    (rom: "nbajam", core: "midway", title: "NBA Jam", players: 4, cabinets: ["nbajam"]),
    (rom: "mslug", core: "neogeo", title: "Metal Slug", bios: Some("neogeo"), cabinets: ["mslug"]),
    (rom: "snowbrosb", core: "snowbros", title: "Snow Bros.", cabinets: ["snowbros"]),
    (rom: "mvscu", core: "capcom", title: "Marvel vs. Capcom", cabinets: ["mvsc"]),
    (rom: "ssriders", core: "konami", title: "Sunset Riders", players: 4, cabinets: ["sunsetriders"]),
    (rom: "dinou", core: "capcom", title: "Cadillacs and Dinosaurs", players: 3, cabinets: ["dino"]),
    (rom: "simpsons", core: "konami", title: "The Simpsons", players: 4, cabinets: ["simpsons"]),
    (rom: "sf2ce", core: "capcom", title: "Street Fighter II' Champion Edition", cabinets: ["sf2ce"]),
    (rom: "pacman", core: "classics", title: "Pac-Man", turns: true, cabinets: ["pacman"]),
    (rom: "atetris", core: "classics", title: "Tetris", cabinets: ["atetris"]),
    (rom: "wboy", core: "classics", title: "Wonder Boy", turns: true, cabinets: ["wboy"]),
    (rom: "invaders", core: "classics", title: "Space Invaders", turns: true, cabinets: ["invaders"]),
    (rom: "asteroid", core: "classics", title: "Asteroids", turns: true, cabinets: ["asteroid"]),
    (rom: "s1945", core: "psikyo", title: "Strikers 1945", cabinets: ["s1945"]),
    (rom: "term2", core: "midway", title: "Terminator 2: Judgment Day", cabinets: ["term2"]),
    (rom: "vs298", core: "supermodel", title: "Virtua Striker 2 '98", lockstep: true, cabinets: ["vs298"]),
    (rom: "daytona", core: "daytona", title: "Daytona USA", arcade: true, players: 8, options: {"cabinets": "1", "link_topology": "star", "link_pace": "1"}, cabinets: ["daytona"]),
    (rom: "tekken3je1", core: "mame", title: "Tekken 3", lockstep: true, cabinets: ["tekken3"]),
    (rom: "timecrs2", core: "mame", title: "Time Crisis II", players: 2, gun: true, linked: true, cabinets: ["timecrs2"]),
    (rom: "vtennisg", core: "flycast", title: "Virtua Tennis", lockstep: true, files: ["vtennisg/gds-0011.chd"], options: {"vab_warmup": "300"}, cabinets: ["vtennis"]),
    (rom: "outrun", core: "outrun", title: "Out Run", players: 1, wheel: Some((lock: 0.3, back: 0.3, curve: 1.0, span: (10600, 23500))), cabinets: ["outrun"]),
    (rom: "crusnusa41", core: "mame", title: "Cruis'n USA", players: 1, wheel: Some((lock: 0.6, back: 0.1, curve: 2.0, span: (5200, 28900))), cabinets: ["crusnusa"]),
]
