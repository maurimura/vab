+         else if (retro_driving && type == IPT_PEDAL2) { id = RETRO_DEVICE_ID_JOYPAD_DOWN; order = 1; label = "Brake"; }
+         else if (retro_driving && type == IPT_PADDLE)
+         {
+            if (player < 4)
+            {
+               add(player, RETRO_DEVICE_JOYPAD, RETRO_DEVICE_ID_JOYPAD_LEFT, 2, "Steer left");
+               add(player, RETRO_DEVICE_JOYPAD, RETRO_DEVICE_ID_JOYPAD_RIGHT, 3, "Steer right");
+            }
