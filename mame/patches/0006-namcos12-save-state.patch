+//-------------------------------------------------
+//  interface_post_load - work to be done after a
+//  state is loaded
+//-------------------------------------------------
+
+void device_execute_interface::interface_post_load()
+{
+	// the loaded queues' events are still to be applied, by timers the load dropped
+	for (device_input &input : m_input)
+		input.post_load();
+}
