+            id = RETRO_DEVICE_ID_JOYPAD_START;
+            order = 20;
+            label = "Start";
+            gun_id = RETRO_DEVICE_ID_LIGHTGUN_START;
+         }
+         else if (type >= IPT_COIN1 && type <= IPT_COIN4)
+         {
