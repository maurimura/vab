 void RamRegion::alloc(size_t size)
 {
+#ifdef __EMSCRIPTEN__
+	// A region freed and allocated again at the same size stays where it was (free() keeps it): the
+	// SH4 -> WebAssembly JIT bakes the regions' addresses into the code it compiles, and keeps that
+	// code across a game reload (hw/sh4/dyna/driver.cpp, Sh4Recompiler::ResetCache). The caller
+	// zeroes the region as it always did.
+	if (ownsMemory && data != nullptr)
+	{
+		if (this->size == size)
+			return;
+		freeAligned(data);
+	}
+#endif
 	this->size = size;
 	data = (u8 *)allocAligned(PAGE_SIZE, size);
 	ownsMemory = true;
@@ -230,6 +242,10 @@
 
 void RamRegion::free()
 {
+#ifdef __EMSCRIPTEN__
+	if (ownsMemory)
+		return; // kept for the next alloc (above)
+#endif
 	this->size = 0;
 	if (ownsMemory)
 		freeAligned(data);
