 void device_scheduler::postload()
 {
+	// the active quanta as saved
+	while (m_quantum_list.first())
+		m_quantum_allocator.reclaim(m_quantum_list.detach(*m_quantum_list.first()));
+	quantum_slot *last = nullptr;
+	for (u32 i = 0; i < std::min<u32>(m_saved_quanta, SAVED_QUANTA); i++)
+	{
+		quantum_slot &quant = *m_quantum_allocator.alloc();
+		quant.m_actual = m_saved_quantum_actual[i];
+		quant.m_requested = m_saved_quantum_requested[i];
+		quant.m_expire = attotime(m_saved_quantum_seconds[i], m_saved_quantum_attoseconds[i]);
+		m_quantum_list.insert_after(quant, last);
+		last = &quant;
+	}
+
 	// remove all timers and make a private list of permanent ones
 	emu_timer *private_list = nullptr;
 	while (m_inactive_timers)
