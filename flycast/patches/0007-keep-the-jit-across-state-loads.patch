 }
+// Every RAM page marked as written at once (a state load, a reset: Sh4Recompiler::ResetCache
+// keeps the compiled modules on this backend): each compiled block, chain and region re-verifies
+// its hash at its next dispatch, as after any write to its pages.
+void fly_mark_all_ram_written() {
+	for (u32 i = 0; i < FLY_PAGE_GEN_COUNT; i++) g_fly_page_gen[i]++;
+	for (u32 i = 0; i < g_rwatch_n; i++) (*g_rwatch_cell[i])++;
+}
 
