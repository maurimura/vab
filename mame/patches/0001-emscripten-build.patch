Build the libretro fork's core with Emscripten (MAME's TARGETOS=asmjs, OSD=retro).

The asmjs configuration in scripts/genie.lua is upstream's SDL3 page: it compiles with SDL3_ttf
(an Emscripten port fetched at compile time) and JavaScript exception catching, which can't be
mixed with -fwasm-exceptions (mame/build.sh passes it in ARCHOPTS). For OSD=retro those options
go; the link options too, since mame/build.sh links the module itself. On asmjs:
- the libretro target is a static archive instead of a shared library (GENie's archive of it
  comes out empty, so mame/build.sh links the target's objects directly);
- no -fPIC: position-independent wasm reaches every global through the GOT, for nothing.
retroprefix.h keyed SDLMAME_EMSCRIPTEN (single-threaded work queues, osd_get_num_processors = 1)
on EMSCRIPTEN, which Emscripten no longer defines under -std=c++20; __EMSCRIPTEN__ now (and the
_IO_FILE stub only for the old macro: today's libc defines it). running_machine's Emscripten main
loop (emscripten_set_main_loop) is upstream's web page, not the libretro core's frame loop.

diff --git a/scripts/genie.lua b/scripts/genie.lua
index b2f8da65..f65df91d 100644
--- a/scripts/genie.lua
+++ b/scripts/genie.lua
@@ -590,7 +590,7 @@ dofile ("toolchain.lua")
 
 -- RETRO HACK
 if _OPTIONS["osd"]=="retro" then
-	if string.sub(_ACTION,1,4) ~= "vs20" then
+	if string.sub(_ACTION,1,4) ~= "vs20" and _OPTIONS["targetos"] ~= "asmjs" then
 		buildoptions {
 			"-fPIC"
 		}
@@ -1167,17 +1167,24 @@ configuration { "asmjs" }
 	buildoptions {
 		"-std=gnu89",
 		"-Wno-implicit-function-declaration",
+	}
+	if _OPTIONS["osd"]~="retro" then
+	buildoptions {
 		"-s USE_SDL_TTF=3",
 		"-Wno-experimental",  -- sdl3 experimental for emcc
 	}
 	buildoptions_cpp {
-		"-std=c++20",
 		"-s EXCEPTION_CATCHING_ALLOWED=\"['_ZN15running_machine17start_all_devicesEv','_ZN8chd_file11open_commonEb','_ZN8chd_file13read_metadataEjjRNSt3__212basic_stringIcNS0_11char_traitsIcEENS0_9allocatorIcEEEE','_ZN8chd_file13read_metadataEjjRNSt3__26vectorIhNS0_9allocatorIhEEEE','_ZNK19netlist_mame_device19base_validity_checkER16validity_checker']\"",
 	}
+	end
+	buildoptions_cpp {
+		"-std=c++20",
+	}
 	defines {
 		"ASIO_HAS_PTHREADS",
 		"SOUND_DISABLE_THREADING",
 	}
+	if _OPTIONS["osd"]~="retro" then
 	linkoptions {
 		"-Wl,--start-group",
 		"-s USE_SDL=3",
@@ -1237,6 +1244,7 @@ configuration { "asmjs" }
 			"-s INITIAL_MEMORY=24MB",
 		}
 	end
+	end
 	archivesplit_size "20"
 
 configuration { "android*" }
