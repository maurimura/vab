+//-------------------------------------------------
+//  post_load - after a state is loaded, arm the
+//  timer that applies the queued events again (the
+//  scheduler drops temporary timers on a load)
+//-------------------------------------------------
+
+void device_execute_interface::device_input::post_load()
+{
+	if (m_qindex > 0)
+		m_execute->scheduler().synchronize(timer_expired_delegate(FUNC(device_execute_interface::device_input::empty_event_queue),this));
+}
