+
+void model2_snd_set_inline(int on)
+{
+    if (on)
+        thread_stop();
+    g_inline = on ? 1 : 0;
+    g_inline_booted = 0;
+}
+
+int model2_snd_inline(void)
+{
+    return g_inline;
+}
+
+void model2_snd_run(signed short *stereo, unsigned frames)
+{
+    if (!stereo || !frames)
+        return;
+    if (!g_inline || !model2_snd_rom_loaded()) {
+        memset(stereo, 0, (size_t)frames * 2u * sizeof(i16));
+        return;
+    }
+    if (!g_inline_booted) {
+        pthread_mutex_lock(&g_cpu_mu);
+        boot_68k();
+        pthread_mutex_unlock(&g_cpu_mu);
+        g_inline_booted = 1;
+    }
+    board_render((i16 *)stereo, frames);
+}
