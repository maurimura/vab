+void run(Env &e) {
+    rt::Cpu &c = e.c;
+    rt::Lockstep &ls = e.ls;
+    for (;;) {
+        if (ls.finished()) return;
+        if (ls.boundary()) continue;
+        i960_step(c, c.m_IP);
+        ++ls.count;
+    }
+}
