+namespace sndgen {
+bool has_code(uint32_t a) { return a == 0x400 || a == 0x410 || a == 0x500 || a == 0x504; }
+uint64_t native_instructions() { return 0; }
+void run(Env &e) {
+    snd::Cpu68k &c = e.c;
+    snd::Sched &s = e.s;
+    for (;;) {
+        if (s.finished()) return;
+        if (s.boundary()) continue;
+        snd_step(c, s, c.pc);
+        ++s.count;
+    }
+}
