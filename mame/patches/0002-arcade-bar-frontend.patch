+static void retro_set_game_descriptors(running_machine &machine)
+{
+   struct entry { unsigned port, device, id, order; std::string label; };
+   static std::vector<std::string> labels;
+   std::vector<entry> entries;
+   std::vector<struct retro_input_descriptor> descriptors;
+   const char *const *names = NULL;
+   const game_driver &system = machine.system();
+   bool gun = false;
+
+   for (const auto &e : game_button_names)
+      if (!strcmp(system.name, e.game) || !strcmp(system.parent, e.game))
+         names = e.buttons;
+
+   auto add = [&] (unsigned port, unsigned device, unsigned id, unsigned order, std::string label)
+   {
+      for (const auto &e : entries)
+         if (e.port == port && e.device == device && e.id == id)
+            return;
+      entries.push_back({ port, device, id, order, std::move(label) });
