+            id = RETRO_DEVICE_ID_JOYPAD_SELECT;
+            order = 21;
+            label = "Coin";
+            gun_id = RETRO_DEVICE_ID_LIGHTGUN_SELECT;
+         }
+         else if (gun && (type == IPT_LIGHTGUN_X || type == IPT_LIGHTGUN_Y))
+         {
+            if (player < 4)
+               add(player, RETRO_DEVICE_LIGHTGUN,
+                     type == IPT_LIGHTGUN_X ? RETRO_DEVICE_ID_LIGHTGUN_SCREEN_X : RETRO_DEVICE_ID_LIGHTGUN_SCREEN_Y,
+                     type == IPT_LIGHTGUN_X ? 30 : 31, type == IPT_LIGHTGUN_X ? "Aim X" : "Aim Y");
+            continue;
+         }
+         else
+            continue;
+
+         if (player >= 4)
+            continue;
+         add(player, RETRO_DEVICE_JOYPAD, id, order, label);
+         if (gun && gun_id >= 0)
+            add(player, RETRO_DEVICE_LIGHTGUN, gun_id, 40 + order, label);
+      }
+   }
