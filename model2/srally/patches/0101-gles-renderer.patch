+        glEnable(GL_SCISSOR_TEST);
+    return g_fbo_color;
+}
+
+void model2_geo_gl_composite_target(void)
+{
+    GLint prev_prog = 0;
+    GLint prev_active = GL_TEXTURE0;
+    GLboolean depth_test;
+
+    if (!g_blit_prog || !g_fbo_color)
+        return;
+    glGetIntegerv(GL_CURRENT_PROGRAM, &prev_prog);
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &prev_active);
+    depth_test = glIsEnabled(GL_DEPTH_TEST);
+
+    glUseProgram(g_blit_prog);
+    if (g_loc_blit_tex >= 0)
+        glUniform1i(g_loc_blit_tex, 0);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, g_fbo_color);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_STENCIL_TEST);
+    glDisable(GL_CULL_FACE);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    glBindBuffer(GL_ARRAY_BUFFER, g_vbo_quad);
+    glEnableVertexAttribArray(ATTR_POS);
+    glVertexAttribPointer(ATTR_POS, 2, GL_FLOAT, GL_FALSE, 0, (const void *)0);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glDisableVertexAttribArray(ATTR_POS);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glDisable(GL_BLEND);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glActiveTexture((GLenum)prev_active);
+    glUseProgram((GLuint)prev_prog);
+    if (depth_test)
+        glEnable(GL_DEPTH_TEST);
+}
+
+void model2_geo_gl_draw_textured(const float *xyzuv, unsigned nverts,
+                                 const model2_geo_tri_mat_t *mats, unsigned ntris)
+{
+    if (!xyzuv || !mats || ntris == 0 || nverts < 3u)
+        return;
+    if (model2_geo_gl_render_offscreen(xyzuv, nverts, mats, ntris) != 0)
+        model2_geo_gl_composite_target();
 }
 
