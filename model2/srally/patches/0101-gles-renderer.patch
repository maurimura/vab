+int model2_gl_have_sync(void)
+{
+#ifdef MODEL2_GL_ES
+    return 1;
+#else
+    static int cached = -1;
+
+    if (cached < 0) {
+        const char *ver = (const char *)glGetString(GL_VERSION);
+        int major = 0, minor = 0;
+
+        if (!ver)
+            return 0; /* no current context yet: ask again later */
+        if (sscanf(ver, "%d.%d", &major, &minor) != 2) {
+            major = 0;
+            minor = 0;
+        }
+        if (major > 3 || (major == 3 && minor >= 2)) {
+            cached = 1;
+        } else {
+            const char *ext = (const char *)glGetString(GL_EXTENSIONS);
+
+            cached = ext && strstr(ext, "GL_ARB_sync") != NULL;
+        }
+#if defined(_WIN32)
+        if (!model2_glFenceSync || !model2_glClientWaitSync || !model2_glDeleteSync)
+            cached = 0;
+#endif
+    }
+    return cached;
+#endif
+}
 
 #else /* !I960_HOST_HAVE_GL */
 
