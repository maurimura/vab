+// vab (supermodel/patches/0005): a result that is a NaN becomes the one quiet NaN the PowerPC
+// itself produces, 0x7FF8000000000000. WebAssembly leaves a NaN's sign and payload to the host
+// (x86 and ARM differ), so two machines playing in lockstep would otherwise drift apart the
+// first time the game computed one and read its bits back.
+static inline double fp_result(double x)
+{
+	if (x != x)
+	{
+		union { UINT64 i; double d; } canonical;
+		canonical.i = 0x7FF8000000000000ULL;
+		return canonical.d;
+	}
+	return x;
+}
+
 #define SET_VXSNAN(a, b)    if (is_snan_double(a) || is_snan_double(b)) ppc.fpscr |= 0x80000000
 #define SET_VXSNAN_1(c)     if (is_snan_double(c)) ppc.fpscr |= 0x80000000
 
